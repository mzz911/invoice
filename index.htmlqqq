document.getElementById('fImgCamera').onchange=e=>{ const isScan=pendingScanMode; pendingScanMode=false; const tgt = window._payDetailId && imgTarget==='pay' ? 'payDetail' : imgTarget; if(tgt==='payDetail'){ processFile(e.target.files[0],isScan,'payDetail'); } else processFile(e.target.files[0],isScan,imgTarget); e.target.value=''; };
