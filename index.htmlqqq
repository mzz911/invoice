function getSuppliers(){ return [...new Set(invoices.map(x=>x.name).filter(Boolean))].sort((a,b)=>a.localeCompare(b)); }
function normSupName(s){ return String(s||'').trim().replace(/\s+/g,' '); }
function showSupSuggest(){ const inp=document.getElementById('fName'); const box=document.getElementById('supSuggest'); const hint=document.getElementById('supHint'); if(!inp||!box) return; const q=normSupName(inp.value).toLowerCase(); if(q.length<2){ box.style.display='none'; if(hint) hint.style.display='none'; return; } const list=getSuppliers().filter(s=>s.toLowerCase().includes(q) && s.toLowerCase()!==q); if(!list.length){ box.style.display='none'; const close=getSuppliers().find(s=>{ const a=s.toLowerCase(), b=q; return a!==b && a.slice(0,4)===b.slice(0,4) && Math.abs(a.length-b.length)<=2; }); if(close && hint){ hint.textContent='⚠️ Maksud kau "'+close+'"? Tekan sini untuk guna.'; hint.style.display='block'; hint.onclick=()=>{ inp.value=close; box.style.display='none'; hint.style.display='none'; }; } else if(hint) hint.style.display='none'; return; } if(hint) hint.style.display='none'; box.innerHTML=list.slice(0,5).map(s=>`<div data-sup="${s.replace(/"/g,'&quot;')}" style="padding:10px 12px;cursor:pointer;border-bottom:1px solid #f1f5f9">👤 ${s}</div>`).join(''); box.style.display='block'; box.querySelectorAll('[data-sup]').forEach(d=>d.onclick=()=>{ inp.value=d.dataset.sup; box.style.display='none'; }); }
document.getElementById('fName').oninput=showSupSuggest;
document.getElementById('addSave').onclick=()=>{ let _raw=document.getElementById('fName').value; let name=normSupName(_raw); const _ex=getSuppliers().find(s=>s.toLowerCase()===name.toLowerCase()); if(_ex) name=_ex; inv=document.getElementById('fInv').value.trim(), date=document.getElementById('fDate').value, cat=document.getElementById('fCat').value, note=(document.getElementById('fNote')?document.getElementById('fNote').value.trim():''); if(!name) name='Tanpa Nama'; if(!inv) inv='INV-' + new Date().toISOString().slice(0,10) + '-' + String(Date.now()).slice(-4); let price=parseFloat(document.getElementById('fPrice').value); if(isNaN(price)) price=0; if(String(inv||'').trim().toUpperCase().startsWith('CN') && price>0) price=-Math.abs(price); if(!date) date=today(); if(editId){ const x=invoices.find(y=>y.id===editId); Object.assign(x,{name,inv,price,date,cat,note,img:pendingImg||x.img}); } else { invoices.unshift({id:Date.now().toString(),name,inv,price,date,cat,note,img:pendingImg,paid:false,pv:'',payDate:'',payMethod:'',paymentImg:''}); } save(); render(); document.getElementById('addModal').classList.remove('open'); const _sb2=document.getElementById('supSuggest'); if(_sb2) _sb2.style.display='none'; const _sh2=document.getElementById('supHint'); if(_sh2) _sh2.style.display='none'; showToast('Invoice disimpan'); };
