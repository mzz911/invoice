<html lang="ms"><style>* { -webkit-text-size-adjust: 109.00000000000001% !important; }</style><head><style>
@font-face {
  font-family: "Optimistic";
  font-style: normal;
  font-weight: 400 600;
  font-display: swap;
  src: url("/fonts/OptimisticAI_VF_Optimized.woff2") format("woff2");
}
@font-face {
  font-family: "Optimistic Mono";
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url("/fonts/OptimisticMono_W_TextRegular.woff2") format("woff2");
}
:where(html) {
  font-family: "Optimistic", system-ui, sans-serif;
}
:where(code, pre, kbd, samp) {
  font-family: "Optimistic Mono", ui-monospace, monospace;
}
</style><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Invoice Kedai - BASECODE</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#eef2ee;color:#111;padding-bottom:110px}
.wrap{max-width:720px;margin:0 auto;padding:14px}
h1{margin:4px 0 2px;font-size:28px}.sub{color:#666;font-size:13px}
.info{background:#d6f5dd;border-radius:14px;padding:12px 14px;font-weight:800;color:#14532d;margin:14px 0 10px}
.row{display:flex;gap:8px;align-items:center;margin:6px 0}
.search{flex:1;display:flex;align-items:center;background:#fff;border:1px solid #ddd;border-radius:12px;padding:10px 12px;gap:8px}
.search input{border:0;outline:0;flex:1;font-size:14px}
.btn{border:0;border-radius:12px;padding:11px 14px;font-weight:700;cursor:pointer}
.btn-green{background:#16a34a;color:#fff}.btn-dark{background:#111827;color:#fff}.btn-light{background:#fff;border:1px solid #ddd}
.btn-small{padding:8px 11px;font-size:12px;border-radius:999px}
.tabs{display:flex;background:#fff;border:1px solid #ddd;border-radius:999px;padding:4px;gap:4px;margin:8px 0}
.tab{flex:1;border:0;background:transparent;padding:8px 4px;border-radius:999px;font-weight:700;cursor:pointer;color:#666;font-size:13px}.tab.active{background:#16a34a;color:#fff}
.group{background:#e8f5e9;border-radius:14px;padding:12px 14px;display:flex;justify-content:space-between;margin:14px 0 8px;cursor:pointer}
.card{background:#fff;border-radius:12px;padding:8px 10px;display:flex;gap:8px;margin:6px 0;align-items:center;box-shadow:0 1px 3px rgba(0,0,0,.06)}
.swipeWrap{position:relative;overflow:hidden;border-radius:12px;margin:6px 0;box-shadow:0 1px 3px rgba(0,0,0,.06)}
.swipeDel{position:absolute;top:0;right:0;bottom:0;width:84px;background:#ff3b30;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;cursor:pointer;z-index:1;border:0;padding:0;font-family:inherit;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
.swipeInner{position:relative;z-index:2;margin:0 !important;transition:transform .2s ease;touch-action:pan-y;background:#fff;will-change:transform}
.thumb{width:46px;height:46px;border-radius:10px;background:#eef2ee;display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0;cursor:pointer;font-size:18px}
.thumb img{width:100%;height:100%;object-fit:cover}
.meta{flex:1;min-width:0;font-size:12px;line-height:1.35}.meta b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:14px;line-height:1.3}
.right{text-align:right;flex-shrink:0;font-size:12px;line-height:1.35}.price{font-weight:800;font-size:14px;line-height:1.3}
.pill{display:inline-block;padding:3px 7px;border-radius:999px;font-size:10px;font-weight:700;margin:1px 0;line-height:1.3}.paid{background:#dcfce7;color:#14532d}.unpaid{background:#fee2e2;color:#991b1b}.pv{background:#dbeafe;color:#1e40af}.cash{background:#fef9c3;color:#854d0e}
.bottom{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1px solid #ddd;padding:12px;padding-bottom:calc(12px + env(safe-area-inset-bottom));z-index:40}
.bottom .btn{width:100%;padding:15px;font-size:16px}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.45);display:none;z-index:50;overflow:auto}
.modal.open{display:block}
.sheet{background:#fff;margin:20px auto;max-width:720px;border-radius:20px;padding:18px;padding-top:16px;position:relative}
.sheet h2{margin:6px 0 12px}
.sheet .closeRow{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.sheet .closeRow button{border:0;background:#f1f5f9;border-radius:999px;padding:8px 12px;font-weight:700;cursor:pointer}
label{font-weight:700;display:block;margin:12px 0 6px}
input,select,textarea{width:100%;padding:12px;border:1px solid #ddd;border-radius:12px;font-size:15px;background:#fff}
.toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);background:#111;color:#fff;padding:10px 16px;border-radius:999px;font-size:13px;z-index:99;display:none}
textarea.csv{height:160px;font-size:12px;font-family:monospace}
</style></head>
<body>
<div class="wrap">
<header><div><h1>Invoice Kedai</h1></div></header>

<div class="info" id="infoBar">0 invoice • RM0.00</div>
<div class="row"><div class="search">🔍 <input id="q" placeholder="Cari supplier / no invoice..." autocomplete="off"></div><button class="btn btn-green" id="filterBtn">Filter <span id="filterCount"></span></button></div>
<div id="searchSuggest" style="display:none;background:#fff;border:1px solid #ddd;border-radius:10px;margin:-2px 0 8px;overflow:hidden;position:relative;z-index:20"></div>
<div class="row"><button class="btn btn-light" id="reportBtn" style="flex:1">📊 Report</button><button class="btn btn-light" id="settingBtn" style="flex:1">⚙️ Setting</button></div>
<div class="tabs"><button class="tab active" data-tab="all">Semua</button><button class="tab" data-tab="paid">Dah Bayar</button><button class="tab" data-tab="unpaid">Belum Bayar</button><button class="tab" data-tab="batal">PV Batal</button></div>
<button class="btn btn-green" id="addBtnTop" style="width:100%;margin:8px 0;padding:14px;font-size:15px;position:sticky;top:0;z-index:30;box-shadow:0 2px 8px rgba(0,0,0,.12)">＋ Tambah Invoice</button>
<div id="list"><p style="text-align:center;color:#666">Tiada invoice</p></div>
</div>


<!-- ADD / EDIT -->
<div class="modal" id="addModal"><div class="sheet">
<div class="closeRow"><button id="addBack">← Kembali</button><b id="addTitle">Tambah Invoice</b><button id="addClose">✕ Tutup</button></div>
<div id="thumbBox" style="width:120px;height:120px;margin:0 auto 8px;border:2px dashed #cbd5e1;border-radius:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;background:#f8fafc;overflow:hidden"><span id="thumbIcon" style="font-size:36px">📷</span><img id="thumbPreview" style="display:none;width:100%;height:100%;object-fit:cover"></div>

<input id="fImg" type="file" accept="image/*" hidden=""><input id="fImgCamera" type="file" accept="image/*" capture="environment" hidden=""><input id="fImgFiles" type="file" accept="image/*" hidden="">
<label>Nama / Supplier</label><input id="fName" placeholder="Nama Supplier" autocomplete="off">

<div id="supSuggest" style="display:none;background:#fff;border:1px solid #ddd;border-radius:10px;margin:-2px 0 8px;overflow:hidden"></div>
<div id="supHint" style="font-size:12px;color:#b45309;font-weight:700;display:none;margin:-2px 0 8px;cursor:pointer"></div>
<label>No Invoice</label><input id="fInv" placeholder="No Invoice">
<label>Harga (RM)</label><input id="fPrice" type="number" step="0.01" placeholder="0.00">
<label>Tarikh Invoice</label><input id="fDate" type="date">
<label>Kategori</label><select id="fCat"><option value="stock">stock</option><option value="kegunaan kedai">kegunaan kedai</option><option value="utilities">utilities</option><option value="gaji">gaji</option><option value="personal">personal</option></select>
<label>Nota / Remark</label><input id="fNote" placeholder="Contoh: pisang nangka 20kg x 2.50">

<div class="row" style="margin-top:16px"><button class="btn btn-light" id="addCancel" style="flex:1">Batal</button><button class="btn btn-green" id="addSave" style="flex:1">Simpan</button></div>
</div></div>

<!-- IMG SOURCE -->
<div class="modal" id="imgSourceModal"><div class="sheet"><div class="closeRow"><button id="srcBack">← Kembali</button><b>Gambar Invoice</b><button id="srcCancel">✕</button></div>
<div style="display:flex;flex-direction:column;gap:10px"><button class="btn btn-light" id="srcCamera" style="padding:16px;text-align:left">📷 Camera</button><button class="btn btn-light" id="srcGallery" style="padding:16px;text-align:left">🖼️ Gallery</button><button class="btn btn-light" id="srcFiles" style="padding:16px;text-align:left">📁 Files</button><button class="btn btn-light" id="srcScan" style="padding:16px;text-align:left">📄 Scan Document</button></div></div></div>

<!-- IMG VIEW -->
<div class="modal" id="imgViewModal"><div class="sheet" style="text-align:center"><div class="closeRow"><button id="imgViewBack">← Kembali</button><b id="imgViewTitle">Gambar</b><button id="imgViewClose">✕ Tutup</button></div><img id="imgViewImg" style="width:100%;border-radius:12px;max-height:70vh;object-fit:contain;background:#000"><p id="imgViewMeta" style="font-size:13px;color:#666"></p></div></div>

<!-- DETAIL -->
<div class="modal" id="detailModal"><div class="sheet"><div class="closeRow"><button id="detailBack">← Kembali</button><b>Detail Invoice</b><button id="detailClose">✕ Tutup</button></div><div id="detailBody"></div></div></div>

<!-- PV DETAIL -->
<div class="modal" id="pvModal"><div class="sheet"><div class="closeRow"><button id="pvBack">← Kembali</button><b>Detail PV</b><button id="pvClose">✕ Tutup</button></div><div id="pvBody"></div></div></div>

<!-- FILTER -->
<div class="modal" id="filterModal"><div class="sheet"><div class="closeRow"><button id="filterBack">← Kembali</button><b>Filter</b><button id="filterClose">✕ Tutup</button></div>
<label>Kategori</label><select id="fltCat"><option value="">Semua kategori</option><option value="stock">stock</option><option value="kegunaan kedai">kegunaan kedai</option><option value="utilities">utilities</option><option value="gaji">gaji</option><option value="personal">personal</option></select>
<label>Status</label><select id="fltStatus"><option value="">Semua</option><option value="paid">Dah Bayar</option><option value="unpaid">Belum Bayar</option></select>
<label>Cara Bayar</label><select id="fltPay"><option value="">Semua</option><option>Cash</option><option>Bank Transfer</option><option>QR / E-Wallet</option><option>Split Payment</option></select>
<div class="row" style="margin-top:14px"><button class="btn btn-light" id="filterReset" style="flex:1">Reset</button><button class="btn btn-green" id="filterApply" style="flex:1">Tunjuk</button></div></div></div>

<!-- REPORT -->
<div class="modal" id="reportModal"><div class="sheet"><div class="closeRow"><button id="reportBack">← Kembali</button><b>Report</b><button id="reportClose">✕ Tutup</button></div>
<div id="reportSummary" style="font-weight:700;margin:8px 0"></div><div id="reportPreview" style="overflow:auto;max-height:220px"></div>
<div class="row" style="margin-top:12px"><button class="btn btn-green" id="dlCsv" style="flex:1">⬇️ Download CSV</button><button class="btn btn-light" id="copyCsv" style="flex:1">📋 Copy CSV</button></div>
<button class="btn btn-dark" id="dlPdf" style="width:100%;margin-top:8px">⬇️ Download PDF</button>
<label>CSV</label><textarea class="csv" id="csvText" readonly=""></textarea>
<button class="btn btn-light" id="reportDone" style="width:100%;margin-top:10px">Tutup</button></div></div>

<!-- SETTING -->
<div class="modal" id="settingModal"><div class="sheet"><div class="closeRow"><button id="settingBack">← Kembali</button><b>⚙️ Setting</b><button id="settingClose">✕ Tutup</button></div>
<div style="display:flex;flex-direction:column;gap:10px">
<button class="btn btn-light" id="settingSync" style="padding:16px;text-align:left">🔄 Sync Google Drive</button>
<button class="btn btn-light" id="settingDriveInfo" style="padding:16px;text-align:left">ℹ️ Google Drive - Info</button>
<button class="btn btn-light" id="settingCatBtn" style="padding:16px;text-align:left">📂 Edit Kategori</button>
<button class="btn btn-light" id="settingImport" style="padding:16px;text-align:left">⬆️ Import DB</button>
<button class="btn btn-light" id="settingExport" style="padding:16px;text-align:left">⬇️ Export DB</button>
</div>

<input type="file" id="importFile" accept=".json" hidden="">
<button class="btn btn-light" id="settingDone" style="width:100%;margin-top:8px">Tutup</button></div></div>

<!-- CATEGORY -->
<div class="modal" id="catModal"><div class="sheet"><div class="closeRow"><button id="catBack">← Kembali</button><b>📂 Edit Kategori</b><button id="catCloseBtn">✕ Tutup</button></div>
<div id="catListBox" style="display:flex;flex-direction:column;gap:8px;margin:10px 0"></div>
<label>Kategori Baru</label><input id="newCatInput" placeholder="Nama kategori"><button class="btn btn-green" id="addCatBtn" style="width:100%;margin-top:8px">＋ Tambah Kategori</button></div></div>

<!-- PAY -->
<div class="modal" id="payModal"><div class="sheet"><div class="closeRow"><button id="payBack">← Kembali</button><b id="payTitle">Bayar</b><button id="payClose">✕ Tutup</button></div>
<div id="payList" style="font-size:14px"></div>
<label>Cara Bayar</label>
<div id="payMethods" style="display:flex;flex-direction:column;gap:8px"></div>
<div id="payAmounts"></div>
<div style="margin-top:12px"><b>Resit Payment</b><div id="payThumbBox" style="width:100px;height:100px;border:2px dashed #cbd5e1;border-radius:12px;display:flex;align-items:center;justify-content:center;cursor:pointer;overflow:hidden;margin-top:6px"><span id="payThumbIcon">📷</span><img id="payThumbPreview" style="display:none;width:100%;height:100%;object-fit:cover"></div></div>
<div class="row" style="margin-top:14px"><button class="btn btn-light" id="payCancel" style="flex:1">Batal</button><button class="btn btn-green" id="payConfirm" style="flex:1">Confirm Bayar</button></div></div></div>

<!-- DRIVE INFO -->
<div class="modal" id="driveModal"><div class="sheet"><div class="closeRow"><button id="driveBack">← Kembali</button><b>Google Drive</b><button id="driveClose">✕ Tutup</button></div>

<button class="btn btn-green" id="openDrive" style="width:100%">Buka Google Drive</button><button class="btn btn-light" id="driveDone" style="width:100%;margin-top:8px">Tutup</button></div></div>

<div class="toast" id="toast"></div>
<script>
let invoices = JSON.parse(localStorage.getItem('ik_invoices')||'[]');

let cancelledPVs = JSON.parse(localStorage.getItem('ik_cancelled')||'[]');
let customCats = JSON.parse(localStorage.getItem('ik_cats')||'[]');
let hiddenCats = JSON.parse(localStorage.getItem('ik_cats_hidden')||'[]');
const DEFAULT_CATS = ['stock','kegunaan kedai','utilities','gaji','personal'];
migrateCN();
let tab='all', query='', filters={cat:'',status:'',pay:''}, selected=new Set(), editId=null, pendingImg='', pendingPayImg='', pendingScanMode=false, payMode='single', payTarget=null, imgTarget='invoice';
function allCats(){ const fromInv=invoices.map(x=>(x.cat||'').trim()).filter(Boolean); const m=[...DEFAULT_CATS.filter(c=>!hiddenCats.includes(c))]; [...customCats,...fromInv].forEach(c=>{if(!m.includes(c))m.push(c)}); return m; }
function save(){ localStorage.setItem('ik_invoices',JSON.stringify(invoices)); localStorage.setItem('ik_cancelled',JSON.stringify(cancelledPVs)); localStorage.setItem('ik_cats',JSON.stringify(customCats)); localStorage.setItem('ik_cats_hidden',JSON.stringify(hiddenCats)); }
function fmt(n){ return 'RM'+Number(n||0).toLocaleString('en-MY',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function fmtDate(d){ if(!d) return ''; const parts=String(d).split('-'); if(parts.length!==3) return d; return parts[2]+'/'+parts[1]+'/'+parts[0].slice(2); }
function isCN(o){ return String(o?.inv||'').trim().toUpperCase().startsWith('CN'); }
function signedPrice(o){ const v=Number(o?.price||0); return isCN(o) ? -Math.abs(v) : v; }
function migrateCN(){ let changed=false; invoices.forEach(x=>{ if(isCN(x) && Number(x.price||0)>0){ x.price=-Math.abs(Number(x.price||0)); changed=true; } }); if(changed) save(); }
function today(){ return new Date().toISOString().slice(0,10); }
function showToast(t){ const el=document.getElementById('toast'); el.textContent=t; el.style.display='block'; setTimeout(()=>el.style.display='none',2200); }
function rebuildCatList(){ const sel=document.getElementById('fCat'); if(sel){ const cur=sel.value; sel.innerHTML=allCats().map(c=>`<option value="${c}">${c}</option>`).join(''); if(cur&&allCats().includes(cur))sel.value=cur; } const f=document.getElementById('fltCat'); if(f){ const cur=f.value; f.innerHTML='<option value="">Semua kategori</option>'+allCats().map(c=>`<option value="${c}">${c}</option>`).join(''); if(cur)f.value=cur; } }
function filtered(){ let list=[...invoices]; if(query){ const q=query.toLowerCase(); list=list.filter(x=>(x.name||'').toLowerCase().includes(q)||(x.inv||'').toLowerCase().includes(q)); } if(filters.cat) list=list.filter(x=>x.cat===filters.cat); if(filters.status) list=list.filter(x=>filters.status==='paid'?x.paid:!x.paid); if(filters.pay) list=list.filter(x=>x.payMethod===filters.pay); if(tab==='paid') list=list.filter(x=>x.paid); if(tab==='unpaid') list=list.filter(x=>!x.paid); if(tab==='batal'){ return []; } return list; }
function gotoTab(name){ tab=name; document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active', x.dataset.tab===name)); selected.clear(); render(); }
function render(){
  rebuildCatList();
  const list=filtered();
  const _tabLabel = tab==='paid' ? ' Dah Bayar' : tab==='unpaid' ? ' Belum Bayar' : '';
  const _total=list.reduce((s,x)=>s+signedPrice(x),0);
  document.getElementById('infoBar').textContent = list.length+' invoice'+_tabLabel+' • '+fmt(_total);
  const box=document.getElementById('list'); box.innerHTML='';
  if(tab==='batal'){
    const _batalTotal=cancelledPVs.reduce((s,c)=>s+Number(c.price||0),0);
    document.getElementById('infoBar').textContent = cancelledPVs.length+' PV Batal • '+fmt(_batalTotal);
    if(!cancelledPVs.length) box.innerHTML='<p style="text-align:center;color:#666">Tiada PV Batal</p>';
    const _batalSorted=[...cancelledPVs].sort((a,b)=>(b.date||'').localeCompare(a.date||'')); let _batalLastDay='';
    _batalSorted.forEach(c=>{ if(c.date!==_batalLastDay){ _batalLastDay=c.date; const _dayItems=_batalSorted.filter(x=>x.date===c.date); const _dayTotal=_dayItems.reduce((s,x)=>s+Number(x.price||0),0); const _hd=document.createElement('div'); _hd.style.cssText='background:#e8f5e9;border-radius:10px;padding:8px 10px;font-weight:700;font-size:13px;margin:10px 0 4px'; _hd.textContent=fmtDate(c.date)+' • '+_dayItems.length+' PV Batal • '+fmt(_dayTotal); box.appendChild(_hd); } const d=document.createElement('div'); d.className='card'; d.innerHTML=`<div class="meta"><b>${c.pv} - BATAL</b><div>${fmtDate(c.date)} • ${c.inv||''} • ${c.name||''}</div><div style="color:#dc2626;font-weight:700">PV Batal - ${fmt(c.price)}</div></div>`; box.appendChild(d); });
    return;
  }
  // Dah Bayar - GROUP ikut PV, tajuk = supplier name
  if(tab==='paid'){
    const _bb2=document.getElementById('bulkBar'); if(_bb2) _bb2.remove();
    const _groups={};
    list.forEach(x=>{ const k=x.pv ? x.pv+'|'+(x.payDate||'') : 'single|'+x.id; if(!_groups[k]) _groups[k]={pv:x.pv,payDate:x.payDate,payMethod:x.payMethod,items:[]}; _groups[k].items.push(x); });
    Object.values(_groups).forEach(g=>g.items.sort((a,b)=>(a.date||'').localeCompare(b.date||'')||(a.inv||'').localeCompare(b.inv||'')));
    const _glist=Object.values(_groups).sort((a,b)=>(b.payDate||'').localeCompare(a.payDate||'')||(b.pv||'').localeCompare(a.pv||''));
    if(!_glist.length) box.innerHTML='<p style="text-align:center;color:#666">Tiada invoice Dah Bayar</p>';
    let _paidLastDay=''; _glist.forEach(g=>{
      if(g.payDate!==_paidLastDay){ _paidLastDay=g.payDate; const _dayGroups=_glist.filter(x=>x.payDate===g.payDate); const _dayTotal=_dayGroups.reduce((s,gg)=>s+gg.items.reduce((s2,x)=>s2+signedPrice(x),0),0); const _dayCount=_dayGroups.reduce((s,gg)=>s+gg.items.length,0); const _hd=document.createElement('div'); _hd.style.cssText='background:#e8f5e9;border-radius:10px;padding:8px 10px;font-weight:700;font-size:13px;margin:10px 0 4px'; _hd.textContent=fmtDate(g.payDate)+' • '+_dayGroups.length+' PV • '+_dayCount+' invoice • '+fmt(_dayTotal); box.appendChild(_hd); }
      const gtotal=g.items.reduce((s,x)=>s+signedPrice(x),0);
      const invs=g.items.map(x=>x.inv||'').filter(Boolean).join(' • ');
      const hasResit=g.items.some(x=>x.paymentImg);
      const d=document.createElement('div'); d.className='card';
      if(g.pv){
        const _names=[...new Set(g.items.map(x=>x.name).filter(Boolean))];
        const _supTitle=_names.length<=1 ? (_names[0]||'Tanpa Nama') : _names[0]+' + '+(_names.length-1)+' lagi';
        d.innerHTML=`<div class="meta"><b>${_supTitle}</b><div>${g.pv} • ${fmtDate(g.payDate)} • ${g.items.length} invoice • ${g.payMethod||''}</div>${_names.length>1?`<div style="font-size:11px;color:#666;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${_names.join(' • ')}</div>`:''}<div style="font-size:11px;color:#666;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${invs}</div></div><div class="right"><div class="price">${fmt(gtotal)}</div><span class="pill paid">${g.items.length} invoice</span>${hasResit?`<div>🧾</div>`:''}</div>`;
        d.onclick=()=>openPVDetail(g.pv,g.payDate);
      } else {
        const x=g.items[0];
        d.innerHTML=`<div class="meta"><b>${x.name}</b><div>${fmtDate(x.date)} • ${x.inv||''} • ${x.cat||''}</div></div><div class="right"><div class="price">${fmt(signedPrice(x))}</div><span class="pill paid">Dah Bayar</span></div>`;
        d.onclick=()=>openDetail(x.id);
      }
      box.appendChild(d);
    });
    return;
  }
  // Semua: Group Dah Bayar ikut PV, sort group by tarikh payment (terbaru dulu). Belum Bayar sort by tarikh invoice (terbaru dulu). Semua campur ikut tarikh - terbaru dulu.
  const _paidGroupsMap={};
  list.filter(x=>x.paid&&x.pv).forEach(x=>{ const k=x.pv+'|'+(x.payDate||''); if(!_paidGroupsMap[k]) _paidGroupsMap[k]={pv:x.pv,payDate:x.payDate,payMethod:x.payMethod,items:[]}; _paidGroupsMap[k].items.push(x); });
  Object.values(_paidGroupsMap).forEach(g=>g.items.sort((a,b)=>(a.date||'').localeCompare(b.date||'')||(a.inv||'').localeCompare(b.inv||'')));
  const _paidGroups=Object.values(_paidGroupsMap).sort((a,b)=>(b.payDate||'').localeCompare(a.payDate||'')||(b.pv||'').localeCompare(a.pv||''));
  const _paidSingles=list.filter(x=>x.paid&&!x.pv).sort((a,b)=>(b.payDate||b.date||'').localeCompare(a.payDate||a.date||''));
  const _unpaidSorted=list.filter(x=>!x.paid).sort((a,b)=>(b.date||'').localeCompare(a.date||'')||(b.inv||'').localeCompare(a.inv||''));
  let _cards=[];
  if(tab==='unpaid'){
    _cards=_unpaidSorted.map(x=>({type:'single',item:x,sortKey:x.date||''}));
  } else {
    _paidGroups.forEach(g=>_cards.push({type:'group',group:g,sortKey:g.payDate||''}));
    _paidSingles.forEach(x=>_cards.push({type:'single',item:x,sortKey:x.payDate||x.date||''}));
    _unpaidSorted.forEach(x=>_cards.push({type:'single',item:x,sortKey:x.date||''}));
    _cards.sort((a,b)=>(b.sortKey||'').localeCompare(a.sortKey||''));
  }
  if(!_cards.length) box.innerHTML='<p style="text-align:center;color:#666">Tiada invoice</p>';
  let _lastDay=''; _cards.forEach(_card=>{
    const _cardDay=_card.sortKey||'';
    if(_cardDay!==_lastDay){ _lastDay=_cardDay; const _dayCards=_cards.filter(c=>c.sortKey===_cardDay); const _dayTotal=_dayCards.reduce((s,c)=>s+(c.type==='group'?c.group.items.reduce((s2,x)=>s2+signedPrice(x),0):signedPrice(c.item)),0); const _dayCount=_dayCards.reduce((s,c)=>s+(c.type==='group'?c.group.items.length:1),0); const _hd=document.createElement('div'); _hd.style.cssText='background:#e8f5e9;border-radius:10px;padding:8px 10px;font-weight:700;font-size:13px;margin:10px 0 4px'; _hd.textContent=fmtDate(_cardDay)+' • '+_dayCount+' invoice • '+fmt(_dayTotal); box.appendChild(_hd); }
    if(_card.type==='group'){
      const g=_card.group; const gtotal=g.items.reduce((s,x)=>s+signedPrice(x),0); const invs=g.items.map(x=>x.inv||'').filter(Boolean).join(' • '); const hasResit=g.items.some(x=>x.paymentImg);
      const _names=[...new Set(g.items.map(x=>x.name).filter(Boolean))]; const _supTitle=_names.length<=1 ? (_names[0]||'Tanpa Nama') : _names[0]+' + '+(_names.length-1)+' lagi';
      const d=document.createElement('div'); d.className='card';
      d.innerHTML=`<div class="meta"><b>${_supTitle}</b><div>${g.pv} • ${fmtDate(g.payDate)} • ${g.items.length} invoice • ${g.payMethod||''}</div>${_names.length>1?`<div style="font-size:11px;color:#666;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${_names.join(' • ')}</div>`:''}<div style="font-size:11px;color:#666;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${invs}</div></div><div class="right"><div class="price">${fmt(gtotal)}</div><span class="pill paid">${g.items.length} invoice</span>${hasResit?`<div>🧾</div>`:''}</div>`;
      d.onclick=()=>openPVDetail(g.pv,g.payDate); box.appendChild(d); return;
    }
    const x=_card.item;
    const c=document.createElement('div'); c.className='swipeWrap';
    const del=document.createElement('button'); del.type='button'; del.className='swipeDel'; del.textContent='Delete';
    const inner=document.createElement('div'); inner.className='card swipeInner';
    c.appendChild(del); c.appendChild(inner);
    const cc=inner;
    const splitTxt = x.payMethod==='Split Payment' && x.split ? 'Split: '+Object.entries(x.split).filter(([k,v])=>v>0).map(([k,v])=>`${k.replace('Bank Transfer','Bank').replace('QR / E-Wallet','QR')} ${Number(v)}`).join(' • ') : '';
    cc.innerHTML=`<input type="checkbox" ${selected.has(x.id)?'checked':''} style="width:22px;height:22px;margin-top:2px">
    <div class="thumb" data-thumb>${x.img?`<img src="${x.img}">`:'📷'}</div>
    <div class="meta"><b>${x.name}</b><div>${fmtDate(x.date)} • ${x.inv||'INV-'} • ${x.cat||''}</div>${x.note?`<div style="font-size:11px;color:#666;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">📝 ${x.note}</div>`:''}${splitTxt?`<div style="font-weight:600">${splitTxt}</div>`:''}${x.payMethod&&x.payMethod!=='Split Payment'?`<span class="pill cash">${x.payMethod}</span>`:''}</div>
    <div class="right"><div class="price">${fmt(signedPrice(x))}</div><span class="pill ${x.paid?'paid':'unpaid'}">${x.paid?'Dah Bayar':'Belum Bayar'}</span>${x.paid&&x.pv?`<div><span class="pill pv">${x.pv}</span></div><div style="font-size:11px;color:#666">Bayar: ${fmtDate(x.payDate)}</div>`:''}${x.paymentImg?`<div>🧾</div>`:''}</div>`;
    cc.querySelector('input').onchange=e=>{ if(e.target.checked)selected.add(x.id); else selected.delete(x.id); render(); };
    const th=cc.querySelector('[data-thumb]'); th.onclick=e=>{ e.stopPropagation(); if(x.img) openImgView(x.img,'Gambar Invoice - '+x.name,(x.inv||'')+' • '+x.date); else showToast('Tiada Gambar Invoice'); };
    let suppressClick=false; cc.onclick=e=>{ if(e.target.tagName==='INPUT')return; if(suppressClick){ suppressClick=false; return; } if(cc.dataset.open==='1'){ closeSwipe(); return; } openDetail(x.id); };
    // Swipe kiri - macam iPhone, keluar Delete
    let delDone=false; function doDel(){ if(delDone) return; delDone=true; invoices=invoices.filter(y=>y.id!==x.id); selected.delete(x.id); save(); render(); showToast('Invoice dipadam'); }
    del.addEventListener('click', e=>{ e.stopPropagation(); doDel(); });
    del.addEventListener('touchend', e=>{ e.preventDefault(); e.stopPropagation(); doDel(); }, {passive:false});
    let sx=0, sy=0, curX=0, swiping=false, opened=false;
    function closeSwipe(){ curX=0; opened=false; cc.dataset.open=''; cc.style.transition='transform .2s ease'; cc.style.transform='translateX(0)'; }
    function closeOthers(){ document.querySelectorAll('.swipeInner').forEach(el=>{ if(el!==cc){ el.dataset.open=''; el.style.transition='transform .2s ease'; el.style.transform='translateX(0)'; } }); }
    cc.addEventListener('touchstart', e=>{ const tt=e.touches[0]; sx=tt.clientX; sy=tt.clientY; curX=opened?-84:0; swiping=false; cc.style.transition='none'; }, {passive:true});
    cc.addEventListener('touchmove', e=>{ const tt=e.touches[0]; const dx=tt.clientX-sx, dy=tt.clientY-sy; if(!swiping && Math.abs(dx)<10) return; if(!swiping && Math.abs(dy)>Math.abs(dx)) return; swiping=true; if(e.cancelable) e.preventDefault(); let nx=curX+dx; nx=Math.max(-84, Math.min(0, nx)); cc.style.transform='translateX('+nx+'px)'; }, {passive:false});
    cc.addEventListener('touchend', e=>{ if(!swiping){ cc.style.transition='transform .2s ease'; return; } swiping=false; cc.style.transition='transform .2s ease'; const tr=cc.style.transform; const cur=parseFloat(tr.replace(/[^0-9\-\.]/g,''))||0; if(cur<-40){ cc.style.transform='translateX(-84px)'; opened=true; cc.dataset.open='1'; closeOthers(); cc.style.transform='translateX(-84px)'; } else { closeSwipe(); } });
    // Mouse untuk test kat laptop
    let mDown=false, mx=0, my=0;
    cc.addEventListener('mousedown', e=>{ mDown=true; mx=e.clientX; my=e.clientY; curX=opened?-84:0; cc.style.transition='none'; });
    cc.addEventListener('mousemove', e=>{ if(!mDown) return; const dx=e.clientX-mx, dy=e.clientY-my; if(Math.abs(dy)>Math.abs(dx)) return; if(Math.abs(dx)<5) return; let nx=curX+dx; nx=Math.max(-84, Math.min(0, nx)); cc.style.transform='translateX('+nx+'px)'; });
    cc.addEventListener('mouseup', e=>{ if(!mDown) return; mDown=false; if(Math.abs(e.clientX-mx)>10) suppressClick=true; setTimeout(()=>suppressClick=false,80); cc.style.transition='transform .2s ease'; const cur=parseFloat((cc.style.transform||'').replace(/[^0-9\-\.]/g,''))||0; if(cur<-40){ cc.style.transform='translateX(-84px)'; opened=true; cc.dataset.open='1'; closeOthers(); cc.style.transform='translateX(-84px)'; } else { closeSwipe(); } });
    box.appendChild(c);
  });
  // bulk bar
  let bar=document.getElementById('bulkBar'); if(selected.size){ if(!bar){ bar=document.createElement('div'); bar.id='bulkBar'; bar.style.cssText='position:fixed;left:12px;right:12px;bottom:78px;background:#111;color:#fff;border-radius:14px;padding:12px;display:flex;gap:8px;align-items:center;z-index:60'; bar.innerHTML='<span id="bulkTxt" style="flex:1"></span><button class="btn btn-green" id="bulkPay">Next →</button>'; document.body.appendChild(bar); document.getElementById('bulkPay').onclick=()=>{ document.getElementById('bulkBar')?.remove(); openPay('bulk'); }; } const _bt=[...selected].map(id=>invoices.find(x=>x.id===id)).filter(Boolean).reduce((s,x)=>s+signedPrice(x),0); document.getElementById('bulkTxt').textContent=selected.size+' dipilih • '+fmt(_bt); } else if(bar) bar.remove();
}
function setThumb(img){ pendingImg=img||''; const p=document.getElementById('thumbPreview'), ic=document.getElementById('thumbIcon'), tx=document.getElementById('thumbText'); if(img){ p.src=img; p.style.display='block'; ic.style.display='none'; if(tx) tx.style.display='none'; } else { p.style.display='none'; ic.style.display='block'; if(tx) tx.style.display='block'; } }
function processFile(file,isScan,target){
  if(!file) return; const r=new FileReader(); r.onload=()=>{ const img=new Image(); img.onload=()=>{ const maxW=2048, sc=Math.min(1,maxW/img.width); const cv=document.createElement('canvas'); cv.width=Math.round(img.width*sc); cv.height=Math.round(img.height*sc); const ctx=cv.getContext('2d'); ctx.drawImage(img,0,0,cv.width,cv.height); const out=cv.toDataURL('image/jpeg',0.92); if(target==='pay'){ pendingPayImg=out; const pp=document.getElementById('payThumbPreview'), pi=document.getElementById('payThumbIcon'); pp.src=out; pp.style.display='block'; pi.style.display='none'; document.getElementById('imgSourceModal').classList.remove('open'); showToast('Gambar dimasukkan'); } else { document.getElementById('imgSourceModal').classList.remove('open'); showCropEditor(out, target, isScan); } }; img.src=r.result; }; r.readAsDataURL(file);
}
function openImgView(src,title,meta){ if(!src)return; document.getElementById('imgViewImg').src=src; document.getElementById('imgViewTitle').textContent=title||'Gambar'; document.getElementById('imgViewMeta').textContent=meta||''; document.getElementById('imgViewModal').classList.add('open'); }
function openDetail(id){ const x=invoices.find(y=>y.id===id); if(!x)return; editId=id; const b=document.getElementById('detailBody'); b.innerHTML=`<h2>${x.name}</h2><p><b>${fmt(signedPrice(x))}</b> • ${fmtDate(x.date)} • ${x.inv}</p><p>Kategori: ${x.cat||'-'}</p>${x.note?`<p>Nota / Remark: ${x.note}</p>`:''}
${x.img?`<div><p style="font-weight:700">Gambar Invoice</p><img src="${x.img}" style="width:100%;border-radius:12px;cursor:pointer" id="dInvImg"></div>`:''}
${x.paid?`<p>Status: Dah Bayar • ${x.payMethod||''}<br>PV: ${x.pv||'-'} • Bayar: ${fmtDate(x.payDate)||'-'}</p>`:''}
${x.paid?`<div><p style="font-weight:700">Resit Payment / Bukti Bayar</p>${x.paymentImg?`<img src="${x.paymentImg}" style="width:100%;border-radius:12px;cursor:pointer" id="dPayImg"><div class="row"><button class="btn btn-light" id="viewPayBtn" style="flex:1">👁️ View Resit Payment</button><button class="btn btn-light" id="changePayBtn" style="flex:1">🔄 Tukar Resit Payment</button></div>`: `<button class="btn btn-light" id="addPayBtn" style="width:100%">＋ Tambah Resit Payment</button>`}</div>`:''}
<div class="row" style="margin-top:12px"><button class="btn btn-light" id="delBtn" style="flex:1">Padam Invoice</button><button class="btn btn-light" id="editBtn" style="flex:1">Edit</button></div>
<button class="btn btn-dark" id="dlPdfOne" style="width:100%;margin-top:8px">⬇️ Download PDF - Invoice + Resit Payment</button>
${!x.paid?`<button class="btn btn-green" id="detailPayBtn" style="width:100%;margin-top:8px">Bayar Invoice Ni</button>`: `<button class="btn btn-light" id="cancelPayBtn" style="width:100%;margin-top:8px">Batal Bayar - Batal 1 PV Ni</button>`}
`;
 const di=b.querySelector('#dInvImg'); if(di) di.onclick=()=>openImgView(x.img,'Gambar Invoice - '+x.name,x.inv+' • '+x.date);
 const dp=b.querySelector('#dPayImg'); if(dp) dp.onclick=()=>openImgView(x.paymentImg,'Resit Payment - '+x.name,x.pv||'');
 const vp=b.querySelector('#viewPayBtn'); if(vp) vp.onclick=()=>openImgView(x.paymentImg,'Resit Payment - '+x.name,x.pv||'');
 const ap=b.querySelector('#addPayBtn'); if(ap) ap.onclick=()=>{ imgTarget='pay'; document.getElementById('fImg').click(); }; // NATIVE
 const cp=b.querySelector('#changePayBtn'); if(cp) cp.onclick=()=>{ imgTarget='pay'; document.getElementById('fImg').click(); }; // NATIVE
 // For add/change pay, we need a handler: when image chosen for pay in detail, save to this invoice
 window._payDetailId = x.id;
 b.querySelector('#delBtn').onclick=()=>{ if(confirm('Padam invoice ni?')){ invoices=invoices.filter(y=>y.id!==id); selected.delete(id); save(); render(); document.getElementById('detailModal').classList.remove('open'); } };
 b.querySelector('#editBtn').onclick=()=>{ document.getElementById('detailModal').classList.remove('open'); document.getElementById('fName').value=x.name; document.getElementById('fInv').value=x.inv; document.getElementById('fPrice').value=x.price; document.getElementById('fDate').value=x.date; rebuildCatList(); document.getElementById('fCat').value=x.cat||''; if(document.getElementById('fNote')) document.getElementById('fNote').value=x.note||'';  document.getElementById('addTitle').textContent='Edit Invoice'; pendingImg=x.img||''; setThumb(pendingImg); document.getElementById('addModal').classList.add('open'); };
 const dp1=b.querySelector('#dlPdfOne'); if(dp1) dp1.onclick=()=>downloadPdfOne(x);
 const payB=b.querySelector('#detailPayBtn'); if(payB) payB.onclick=()=>{ document.getElementById('detailModal').classList.remove('open'); openPay('single',x.id); };
 const canB=b.querySelector('#cancelPayBtn'); if(canB) canB.onclick=()=>{ const _n=invoices.filter(y=>y.paid&&y.pv===x.pv&&y.payDate===x.payDate).length; const ok=cancelPV(x.pv,x.payDate); document.getElementById('detailModal').classList.remove('open'); if(ok){ showToast('PV dibatalkan - '+x.pv+' - '+_n+' invoice jadi Belum Bayar'); gotoTab('batal'); } };
 document.getElementById('detailModal').classList.add('open');
}
function nextPV(){ const nums=invoices.filter(x=>x.pv).map(x=>parseInt((x.pv||'').split('-')[2]||'0')); const maxv=Math.max(0,...nums, ...cancelledPVs.map(c=>parseInt((c.pv||'').split('-')[2]||'0'))); const d=new Date(); const yy=String(d.getFullYear()).slice(2), mm=String(d.getMonth()+1).padStart(2,'0'); return `PV-${yy}${mm}-${String(maxv+1).padStart(3,'0')}`; }
function openPay(mode, singleId){
  payMode=mode; payTarget = mode==='single'? [singleId] : [...selected];
  const items=payTarget.map(id=>invoices.find(x=>x.id===id)).filter(Boolean);
  document.getElementById('payTitle').textContent='Bayar - '+items.length+' invoice • '+fmt(items.reduce((s,x)=>s+signedPrice(x),0));
  document.getElementById('payList').innerHTML=items.map(x=>`<div>• ${x.name} - ${fmt(signedPrice(x))} - ${x.inv}${isCN(x)?' (CN - Credit Note)':''}</div>`).join('');
  pendingPayImg='';
  const pp=document.getElementById('payThumbPreview'); pp.style.display='none'; document.getElementById('payThumbIcon').style.display='block';
  const methods=['Cash','Bank Transfer','QR / E-Wallet'];
  document.getElementById('payMethods').innerHTML=methods.map(m=>`<label style="display:flex;gap:8px;align-items:center;margin:0"><input type="checkbox" value="${m}" class="pm" style="width:20px"> ${m}</label>`).join('');
  document.getElementById('payAmounts').innerHTML='';
  document.querySelectorAll('.pm').forEach(cb=>cb.onchange=renderPayAmounts);
  document.getElementById('payModal').classList.add('open');
}
function renderPayAmounts(){ const checked=[...document.querySelectorAll('.pm:checked')].map(c=>c.value); const box=document.getElementById('payAmounts'); if(!checked.length){ box.innerHTML=''; return; } const total=payTarget.map(id=>invoices.find(x=>x.id===id)).reduce((s,x)=>s+signedPrice(x),0); const _old={}; document.querySelectorAll('[data-amt]').forEach(inp=>{ _old[inp.dataset.amt]=inp.value; }); box.innerHTML='<label>Amount</label>'+checked.map((m,i)=>{ let v=_old[m]; if(v===undefined||v===''){ v = (checked.length===1||i===0) ? Number(total).toFixed(2) : '0.00'; } return `<label>${m}</label><input data-amt="${m}" type="number" step="0.01" value="${v}">`; }).join(''); }
function csvFor(list){
  const head='Tarikh Invoice,No Invoice,Supplier,Kategori,Cara Bayar,Split,Status,Tarikh Bayar,PV,Harga,Nota';
  const rows=list.map(x=>{
    const split = x.payMethod==='Split Payment' && x.split ? Object.entries(x.split).filter(([k,v])=>v>0).map(([k,v])=>`${k} ${v}`).join(' • ') : '';
    const esc=v=>`"${String(v||'').replace(/"/g,'""')}"`;
    return [x.date,x.inv,x.name,x.cat,x.payMethod,split,x.paid?'Dah Bayar':'Belum Bayar',x.payDate,x.pv,signedPrice(x),x.note].map(esc).join(',');
  });
  return head+'\n'+rows.join('\n');
}
async function downloadPdfOne(x){
  if(!window.jspdf){ alert('jsPDF belum load, check internet'); return; }
  const { jsPDF } = window.jspdf; const doc=new jsPDF(); let y=12;
  doc.setFontSize(16); doc.text('Invoice Kedai - Payment Voucher',10,y); y+=10;
  doc.setFontSize(11); doc.text(`Supplier: ${x.name}`,10,y); y+=7; doc.text(`No Invoice: ${x.inv}`,10,y); y+=7; doc.text(`Invoice Date: ${x.date}`,10,y); y+=7; doc.text(`Price: RM ${Number(signedPrice(x)).toFixed(2)}${isCN(x)?' (CN - Credit Note)':''}`,10,y); y+=7; doc.text(`PV: ${x.pv||'-'}  PV Date: ${x.payDate||'-'}`,10,y); y+=7; doc.text(`Cara Bayar: ${x.payMethod||'-'}`,10,y); y+=7; doc.text(`Status: ${x.paid?'Dah Bayar':'Belum Bayar'}`,10,y); y+=10;
  // Jimat pages: gambar invoice + resit sebelah-sebelah, 1 page je, tak payah page baru sorang-sorang
  const _hasImg=!!x.img; const _hasResit=!!x.paymentImg;
  if(_hasImg && _hasResit){
    if(y>200){ doc.addPage(); y=12; }
    doc.setFontSize(10); doc.text('Gambar Invoice:',10,y); doc.text('Resit Payment:',105,y); y+=4;
    try{ doc.addImage(x.img,'JPEG',10,y,85,55); }catch(e){}
    try{ doc.addImage(x.paymentImg,'JPEG',105,y,85,55); }catch(e){}
    y+=60;
  } else if(_hasImg){
    if(y>200){ doc.addPage(); y=12; }
    doc.setFontSize(10); doc.text('Gambar Invoice:',10,y); y+=4;
    try{ doc.addImage(x.img,'JPEG',10,y,90,60); }catch(e){}
    y+=66;
  } else if(_hasResit){
    if(y>200){ doc.addPage(); y=12; }
    doc.setFontSize(10); doc.text('Resit Payment:',10,y); y+=4;
    try{ doc.addImage(x.paymentImg,'JPEG',10,y,90,60); }catch(e){}
    y+=66;
  } else if(x.paid){ doc.text('Resit Payment: Tiada',10,y); }
  doc.save((x.pv||'')+'-'+x.inv+'.pdf');
}
function cancelPV(pv, payDate){
  try{
  const _sp=(o)=>{ try{ if(typeof signedPrice==='function') return signedPrice(o); }catch(e){} const v=Number(o?.price||0); return String(o?.inv||'').trim().toUpperCase().startsWith('CN') ? -Math.abs(v) : v; };
  const items=invoices.filter(x=>x.paid&&x.pv===pv&&x.payDate===payDate);
  if(!items.length){ alert('PV '+pv+' tak jumpa / dah batal'); return false; }
  const total=items.reduce((s,x)=>s+_sp(x),0);
  cancelledPVs.unshift({pv,date:payDate,inv:items.map(x=>x.inv||'').join(' • '),name:items.length>1?items.length+' invoice':items[0].name,price:total});
  items.forEach(x=>{ x.paid=false; x.pv=''; x.payDate=''; x.payMethod=''; x.paymentImg=''; x.split=null; });
  save(); render();
  return true;
  }catch(err){ alert('Batal PV gagal: '+err.message); console.error(err); return false; }
}
function openPVDetail(pv, payDate){
  const items=invoices.filter(x=>x.paid&&x.pv===pv&&x.payDate===payDate).sort((a,b)=>(a.date||'').localeCompare(b.date||''));
  if(!items.length) return;
  const total=items.reduce((s,x)=>s+signedPrice(x),0);
  const resits=[...new Set(items.map(x=>x.paymentImg).filter(Boolean))];
  const b=document.getElementById('pvBody');
  b.innerHTML=`<h2>${pv}</h2><p><b>${fmt(total)}</b> • ${fmtDate(payDate)} • ${items.length} invoice</p><p>Cara Bayar: ${items[0].payMethod||'-'}</p>`
    + items.map((x,i)=>`<div class="card" data-pv-inv="${x.id}" style="cursor:pointer"><div class="meta"><b>${i+1}. ${x.name}</b><div>${fmtDate(x.date)} • ${x.inv||''} • ${x.cat||''}</div>${x.note?`<div style="font-size:11px;color:#666">📝 ${x.note}</div>`:''}</div><div class="right"><div class="price">${fmt(signedPrice(x))}</div></div></div>`).join('')
    + (resits.length?`<div><p style="font-weight:700">Resit Payment</p>`+resits.map((r,i)=>`<img src="${r}" data-resit="${i}" style="width:100%;border-radius:12px;cursor:pointer;margin-bottom:8px">`).join('')+`<button class="btn btn-light" id="changePVPayBtn" style="width:100%">🔄 Tukar Resit Payment</button></div>`:`<p>Resit Payment: Tiada</p><button class="btn btn-light" id="addPVPayBtn" style="width:100%">＋ Tambah Resit Payment</button>`)
    + `<button class="btn btn-dark" id="dlPdfPV" style="width:100%;margin-top:8px">⬇️ Download PDF - ${pv}</button>`
    + `<button class="btn btn-light" id="cancelPVBtn" style="width:100%;margin-top:8px;background:#fef2f2;color:#dc2626;border:1px solid #fecaca">❌ Cancel PV</button>❌ Cancel PV</button>`;
  b.querySelectorAll('[data-pv-inv]').forEach(el=>el.onclick=()=>{ document.getElementById('pvModal').classList.remove('open'); openDetail(el.dataset.pvInv); });
  b.querySelectorAll('[data-resit]').forEach((el,i)=>el.onclick=()=>openImgView(resits[i],'Resit Payment - '+pv,pv));
  const apPV=b.querySelector('#addPVPayBtn'); if(apPV) apPV.onclick=()=>{ window._payPV={pv,payDate}; imgTarget='payPV'; document.getElementById('fImg').click(); };
  const cpPV=b.querySelector('#changePVPayBtn'); if(cpPV) cpPV.onclick=()=>{ window._payPV={pv,payDate}; imgTarget='payPV'; document.getElementById('fImg').click(); };
  const dp=b.querySelector('#dlPdfPV'); if(dp) dp.onclick=()=>downloadPdfPV(pv,payDate);
  const cpv=b.querySelector('#cancelPVBtn'); if(cpv) cpv.onclick=()=>{ const ok=cancelPV(pv,payDate); document.getElementById('pvModal').classList.remove('open'); if(ok){ showToast('PV dibatalkan - '+pv+' - '+items.length+' invoice jadi Belum Bayar'); gotoTab('batal'); } };

  document.getElementById('pvModal').classList.add('open');
}
async function downloadPdfPV(pv, payDate){
  if(!window.jspdf){ alert('jsPDF belum load, check internet'); return; }
  const items=invoices.filter(x=>x.paid&&x.pv===pv&&x.payDate===payDate).sort((a,b)=>(a.date||'').localeCompare(b.date||''));
  const total=items.reduce((s,x)=>s+signedPrice(x),0);
  const { jsPDF }=window.jspdf; const doc=new jsPDF(); let y=12;
  doc.setFontSize(16); doc.text('Payment Voucher',10,y); y+=9;
  doc.setFontSize(12); doc.text(pv,10,y); y+=8;
  doc.setFontSize(11); doc.text('Tarikh PV: '+fmtDate(payDate)+'  |  '+items.length+' invoice  |  Total: RM '+Number(total).toFixed(2),10,y); y+=7;
  doc.text('Cara Bayar: '+(items[0]?.payMethod||'-'),10,y); y+=10;
  doc.setFontSize(11); doc.text('Senarai No Invoice / CN:',10,y); y+=7;
  items.forEach((x,i)=>{
    if(y>260){ doc.addPage(); y=12; }
    doc.setFontSize(11); doc.text((i+1)+'. '+x.name+' - '+(x.inv||'')+' - '+fmtDate(x.date)+' - RM '+Number(signedPrice(x)).toFixed(2),10,y); y+=7;
    if(x.note){ if(y>260){ doc.addPage(); y=12; } doc.setFontSize(10); doc.text('   Nota: '+String(x.note).slice(0,80),10,y); y+=7; }
  });
  y+=3; doc.setFontSize(12); doc.text('Jumlah: RM '+Number(total).toFixed(2),10,y);
  // Jimat pages: gambar invoice + resit susun grid 2 lajur x 4 baris = 8 gambar 1 page, kecik je
  const _invImgs=items.filter(x=>x.img).map(x=>({label:(x.inv||x.name||'Invoice').slice(0,22),src:x.img}));
  const _resitImgs=[...new Set(items.map(x=>x.paymentImg).filter(Boolean))].map((r,i)=>({label:'Resit Payment '+(i+1),src:r}));
  const _allImgs=[..._invImgs.map(o=>({...o,kind:'Gambar'})),..._resitImgs.map(o=>({...o,kind:'Resit'}))];
  if(!_allImgs.length){ y+=8; doc.setFontSize(11); doc.text('Resit Payment: Tiada',10,y); }
  else {
    doc.addPage();
    let _pageY=12;
    _allImgs.forEach((im,idx)=>{
      const _perPage=8; const _pos=idx%_perPage;
      if(idx>0 && _pos===0){ doc.addPage(); _pageY=12; }
      const _col=_pos%2; const _row=Math.floor(_pos/2);
      const _x=10+_col*95; const _y=12+_row*66;
      doc.setFontSize(9); doc.text(im.kind+' - '+im.label,_x,_y);
      try{ doc.addImage(im.src,'JPEG',_x,_y+2,85,55); }catch(e){}
    });
  }
  doc.save(pv+'.pdf');
}
async function downloadPdfBulk(list){
  if(!window.jspdf){ alert('jsPDF belum load'); return; }
  const { jsPDF } = window.jspdf; const doc=new jsPDF();
  for(let i=0;i<list.length;i++){ const x=list[i]; if(i>0) doc.addPage(); let y=12; doc.setFontSize(14); doc.text(`${x.name}`,10,y); y+=8; doc.setFontSize(11); doc.text(`No Invoice: ${x.inv}  Date: ${x.date}`,10,y); y+=7; doc.text(`Price: RM ${Number(signedPrice(x)).toFixed(2)}  PV: ${x.pv||'-'}  PV Date: ${x.payDate||'-'}`,10,y); y+=7; doc.text(`Cara Bayar: ${x.payMethod||'-'}  Status: ${x.paid?'Dah Bayar':'Belum Bayar'}`,10,y); y+=10; if(x.img){ doc.text('Gambar Invoice:',10,y); y+=4; try{ doc.addImage(x.img,'JPEG',10,y,90,60); y+=66; }catch(e){} } if(x.paymentImg){ if(y>200){ doc.addPage(); y=12; } doc.text('Resit Payment:',10,y); y+=4; try{ doc.addImage(x.paymentImg,'JPEG',10,y,90,60); }catch(e){} } showToast(`Generating PDF ${i+1}/${list.length}`); }
  doc.save('invoice-kedai-gambar-'+today()+'.pdf');
}
// Wiring
function showSearchSuggest(){ const inp=document.getElementById('q'); const box=document.getElementById('searchSuggest'); if(!inp||!box) return; const q=String(inp.value||'').trim().toLowerCase(); if(q.length<2){ box.style.display='none'; return; } const all=getSuppliers(); let list=all.filter(s=>s.toLowerCase().includes(q) && s.toLowerCase()!==q); if(!list.length){ const close=all.find(s=>{ const a=s.toLowerCase(); return a!==q && a.slice(0,4)===q.slice(0,4) && Math.abs(a.length-q.length)<=2; }); if(close) list=[close]; } if(!list.length){ box.style.display='none'; return; } box.innerHTML=list.slice(0,5).map(s=>{ const n=invoices.filter(x=>x.name===s).length; return `<div data-search-sup="${s.replace(/"/g,'&quot;')}" style="padding:11px 12px;cursor:pointer;border-bottom:1px solid #f1f5f9;display:flex;justify-content:space-between;align-items:center;gap:8px"><span>👤 ${s}</span><span style="font-size:11px;color:#666;flex-shrink:0">${n} invoice</span></div>`; }).join(''); box.style.display='block'; box.querySelectorAll('[data-search-sup]').forEach(d=>d.onclick=()=>{ inp.value=d.dataset.searchSup; query=inp.value; box.style.display='none'; render(); inp.focus(); }); }
document.getElementById('q').oninput=e=>{ query=e.target.value; render(); showSearchSuggest(); };
