// Override processFile for payDetail: if target is payDetail, save to that invoice
const _origProcess = processFile;
processFile = function(file,isScan,target){
  if(target==='payDetail'){
    if(!file) return; const r=new FileReader(); r.onload=()=>{ const img=new Image(); img.onload=()=>{ const maxW=1600, sc=Math.min(1,maxW/img.width); const cv=document.createElement('canvas'); cv.width=Math.round(img.width*sc); cv.height=Math.round(img.height*sc); const ctx=cv.getContext('2d'); ctx.drawImage(img,0,0,cv.width,cv.height); const out=cv.toDataURL('image/jpeg',0.85); const inv=invoices.find(x=>x.id===window._payDetailId); if(inv){ inv.paymentImg=out; save(); render(); openDetail(inv.id); showToast('Resit Payment disimpan'); } }; img.src=r.result; }; r.readAsDataURL(file); return;
  }
  if(target==='payPV'){
    if(!file) return; const r=new FileReader(); r.onload=()=>{ const img=new Image(); img.onload=()=>{ const maxW=1600, sc=Math.min(1,maxW/img.width); const cv=document.createElement('canvas'); cv.width=Math.round(img.width*sc); cv.height=Math.round(img.height*sc); const ctx=cv.getContext('2d'); ctx.drawImage(img,0,0,cv.width,cv.height); const out=cv.toDataURL('image/jpeg',0.85); const pvInfo=window._payPV; if(pvInfo){ const items=invoices.filter(x=>x.paid&&x.pv===pvInfo.pv&&x.payDate===pvInfo.payDate); items.forEach(x=>{ x.paymentImg=out; }); if(items.length){ save(); render(); openPVDetail(pvInfo.pv,pvInfo.payDate); showToast('Resit Payment disimpan - '+items.length+' invoice'); } } }; img.src=r.result; }; r.readAsDataURL(file); return;
  }
  _origProcess(file,isScan,target);
};
