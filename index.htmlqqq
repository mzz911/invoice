document.getElementById('payConfirm').onclick=()=>{
  const checked=[...document.querySelectorAll('.pm:checked')].map(c=>c.value);
  if(!checked.length){ alert('Pilih cara bayar dulu'); return; }
  const items=payTarget.map(id=>invoices.find(x=>x.id===id)).filter(Boolean);
  const total=items.reduce((s,x)=>s+signedPrice(x),0);
  let payMethod='', split=null;
  if(checked.length===1){ payMethod=checked[0]; }
  else { payMethod='Split Payment'; split={}; let sum=0; for(const m of checked){ const v=parseFloat(document.querySelector(`[data-amt="${m}"]`)?.value||'0'); split[m]=v; sum+=v; } if(Math.abs(sum-total)>0.01){ alert(`Total split ${fmt(sum)} tak sama dengan total invoice ${fmt(total)}`); return; } }
  const pv=nextPV(); const pd=today();
  items.forEach(x=>{ x.paid=true; x.pv=pv; x.payDate=pd; x.payMethod=payMethod; if(split) x.split=split; if(pendingPayImg) x.paymentImg=pendingPayImg; });
  selected.clear(); save(); document.getElementById('payModal').classList.remove('open'); showToast(`Bayar siap - ${pv} - ${items.length} invoice`); gotoTab('paid');
};

// ===== EDIT SCAN =====
function solveHomography(src, dst){
  const A=[]; const b=[];
  for(let i=0;i<4;i++){ const x=src[i].x, y=src[i].y, u=dst[i].x, v=dst[i].y; A.push([x,y,1,0,0,0,-u*x,-u*y]); b.push(u); A.push([0,0,0,x,y,1,-v*x,-v*y]); b.push(v); }
  const n=8; const M=[]; for(let i=0;i<n;i++){ M.push(A[i].concat([b[i]])); }
  for(let i=0;i<n;i++){ let piv=i; for(let r=i+1;r<n;r++) if(Math.abs(M[r][i])>Math.abs(M[piv][i])) piv=r; const tmp=M[i]; M[i]=M[piv]; M[piv]=tmp; const d=M[i][i]; if(Math.abs(d)<1e-9) return null; for(let j=i;j<=n;j++) M[i][j]/=d; for(let r=0;r<n;r++){ if(r===i) continue; const f=M[r][i]; for(let j=i;j<=n;j++) M[r][j]-=f*M[i][j]; } }
  const h=[]; for(let i=0;i<n;i++) h.push(M[i][n]); h.push(1); return h;
}
function invert3x3(m){
  const a=m[0],b=m[1],c=m[2],d=m[3],e=m[4],f=m[5],g=m[6],h=m[7],i=m[8];
  const A=e*i-f*h, B=-(d*i-f*g), C=d*h-e*g; const det=a*A+b*B+c*C; if(Math.abs(det)<1e-9) return null;
  const inv=1/det; return [A*inv, -(b*i-c*h)*inv, (b*f-c*e)*inv, B*inv, (a*i-c*g)*inv, -(a*f-c*d)*inv, C*inv, -(a*h-b*g)*inv, (a*e-b*d)*inv];
}
function warpPerspective(dataUrl, quadPct, cb){
  if(!quadPct || quadPct.length!==4) quadPct=[{x:0,y:0},{x:100,y:0},{x:100,y:100},{x:0,y:100}];
  const im=new Image(); im.onload=()=>{
    const maxW=2048; const sc=Math.min(1, maxW/im.width); const sw=Math.round(im.width*sc), sh=Math.round(im.height*sc);
    const srcCv=document.createElement('canvas'); srcCv.width=sw; srcCv.height=sh; const sctx=srcCv.getContext('2d'); sctx.drawImage(im,0,0,sw,sh);
    const srcData=sctx.getImageData(0,0,sw,sh).data;
    const q=quadPct.map(p=>({x:p.x/100*sw, y:p.y/100*sh}));
    const topLen=Math.hypot(q[1].x-q[0].x, q[1].y-q[0].y); const botLen=Math.hypot(q[2].x-q[3].x, q[2].y-q[3].y);
    const leftLen=Math.hypot(q[3].x-q[0].x, q[3].y-q[0].y); const rightLen=Math.hypot(q[2].x-q[1].x, q[2].y-q[1].y);
    const outW=Math.max(200, Math.round((topLen+botLen)/2)); const outH=Math.max(200, Math.round((leftLen+rightLen)/2));
    const dst=[{x:0,y:0},{x:outW,y:0},{x:outW,y:outH},{x:0,y:outH}];
    const H=solveHomography(q, dst); const Hinv=invert3x3(H); if(!Hinv){ cb(dataUrl); return; }
    const outCv=document.createElement('canvas'); outCv.width=outW; outCv.height=outH; const octx=outCv.getContext('2d');
    const outImg=octx.createImageData(outW,outH); const od=outImg.data;
    for(let y=0;y<outH;y++){ for(let x=0;x<outW;x++){ const denom=Hinv[6]*x+Hinv[7]*y+Hinv[8]; const sx=(Hinv[0]*x+Hinv[1]*y+Hinv[2])/denom; const sy=(Hinv[3]*x+Hinv[4]*y+Hinv[5])/denom; const idx=(y*outW+x)*4; if(sx<0||sy<0||sx>=sw-1||sy>=sh-1){ od[idx+3]=0; continue; } const x0=Math.floor(sx), y0=Math.floor(sy); const fx=sx-x0, fy=sy-y0; for(let c=0;c<3;c++){ const p00=srcData[(y0*sw+x0)*4+c], p10=srcData[(y0*sw+Math.min(sw-1,x0+1))*4+c]; const p01=srcData[(Math.min(sh-1,y0+1)*sw+x0)*4+c], p11=srcData[(Math.min(sh-1,y0+1)*sw+Math.min(sw-1,x0+1))*4+c]; const val=(p00*(1-fx)+p10*fx)*(1-fy)+(p01*(1-fx)+p11*fx)*fy; od[idx+c]=val; } od[idx+3]=255; } }
    octx.putImageData(outImg,0,0); cb(outCv.toDataURL('image/jpeg',0.92));
  }; im.src=dataUrl;
}
function showCropEditor(dataUrl, target, isScan){
  const existing=document.getElementById('cropModal'); if(existing) existing.remove();
  const m=document.createElement('div'); m.id='cropModal'; m.className='modal open';
  m.innerHTML = `<div class="sheet" style="text-align:center;padding:0;background:#000;color:#fff;border-radius:0;max-width:100%;height:100dvh;display:flex;flex-direction:column;overflow:hidden"><div id="cropHeader" class="closeRow" style="margin:0;background:#000;color:#fff;padding:16px 16px 12px;display:flex;justify-content:space-between;align-items:center"><button id="cropCancel" style="background:transparent;color:#fff;border:0;font-size:18px">✕</button><b id="cropTitle" style="color:#fff;font-size:18px">Edit Scan</b><button id="cropUse" style="background:#000;color:#fff;border:1px solid rgba(255,255,255,0.4);padding:8px 18px;border-radius:999px;font-weight:600;font-size:15px">Next</button></div>
  <div id="editStage" style="flex:1;display:flex;flex-direction:column">
  <div id="cropViewport" style="position:relative;width:100%;flex:1;overflow:hidden;background:#000;border-radius:0;touch-action:pan-x pan-y;display:flex;justify-content:center;align-items:center;padding:12px 12px 28px;box-sizing:border-box">
  <div id="zoomSpacer" style="position:relative;margin:auto;display:flex;justify-content:center;align-items:flex-start">
  <div id="cropWrap" style="position:relative;flex:0 0 auto;background:#000;border-radius:0;overflow:hidden;touch-action:none;transform-origin:0 0">
    <img id="cropImg" src="${dataUrl}" style="width:100%;height:auto;display:block;border-radius:0">
    <svg id="dimSvg" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:1"><path id="dimPath" d="" fill="rgba(0,0,0,0.55)" fill-rule="evenodd"></path></svg>
    <svg id="quadSvg" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:2"><polygon id="quadPoly" points="" fill="rgba(168,85,247,0.02)" stroke="#c026d3" stroke-width="1" vector-effect="non-scaling-stroke" opacity="1"></polygon></svg>
    <div data-quad="0" style="position:absolute;width:22px;height:22px;background:#fff;border:1.5px solid rgba(255,255,255,0.9);border-radius:50%;transform:translate(-50%,-50%);z-index:3;touch-action:none;box-shadow:0 1px 5px rgba(0,0,0,.5),0 0 0 1px rgba(0,0,0,0.15);cursor:grab"></div>
    <div data-quad="1" style="position:absolute;width:22px;height:22px;background:#fff;border:1.5px solid rgba(255,255,255,0.9);border-radius:50%;transform:translate(-50%,-50%);z-index:3;touch-action:none;box-shadow:0 1px 5px rgba(0,0,0,.5),0 0 0 1px rgba(0,0,0,0.15);cursor:grab"></div>
    <div data-quad="2" style="position:absolute;width:22px;height:22px;background:#fff;border:1.5px solid rgba(255,255,255,0.9);border-radius:50%;transform:translate(-50%,-50%);z-index:3;touch-action:none;box-shadow:0 1px 5px rgba(0,0,0,.5),0 0 0 1px rgba(0,0,0,0.15);cursor:grab"></div>
    <div data-quad="3" style="position:absolute;width:22px;height:22px;background:#fff;border:1.5px solid rgba(255,255,255,0.9);border-radius:50%;transform:translate(-50%,-50%);z-index:3;touch-action:none;box-shadow:0 1px 5px rgba(0,0,0,.5),0 0 0 1px rgba(0,0,0,0.15);cursor:grab"></div>
  </div>
  </div>
  <div id="loupe" style="display:none;position:absolute;width:170px;height:170px;border-radius:50%;border:1.5px solid #fff;background:#000;overflow:hidden;z-index:20;pointer-events:none;box-shadow:0 4px 20px rgba(0,0,0,.5),0 0 0 1px rgba(168,85,247,0.6)">
    <img id="loupeImg" src="" style="position:absolute;transform-origin:0 0;will-change:transform">
    <div style="position:absolute;left:50%;top:50%;width:22px;height:22px;transform:translate(-50%,-50%);border:1px solid #fff;border-radius:50%;background:rgba(255,255,255,0.02);box-shadow:0 0 0 1px rgba(168,85,247,0.7)"></div>
    <div style="position:absolute;left:50%;top:0;bottom:0;width:0.5px;background:rgba(168,85,247,0.6)"></div>
    <div style="position:absolute;top:50%;left:0;right:0;height:0.5px;background:rgba(168,85,247,0.6)"></div>
  </div>
  </div>
  <p style="font-size:11px;color:#999;margin:8px 12px 12px"></p>
  </div>
  <div id="reviewStage" style="display:none;text-align:center;background:#000;color:#fff;flex:1;flex-direction:column">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;background:#000;padding:4px 0"><button id="reviewBack" style="background:transparent;color:#fff;border:0;width:38px;height:38px;border-radius:50%;font-size:18px;cursor:pointer">←</button><b style="color:#fff">Review</b><button id="reviewDone" style="background:#fff;color:#000;border:0;padding:9px 18px;border-radius:999px;font-weight:700;cursor:pointer">✓</button></div>
    <img id="reviewImg" src="" style="width:100%;border-radius:0;display:block;background:#000;flex:1;object-fit:contain">
    <p style="font-size:12px;color:#aaa;margin:10px 0 0"></p>
    <button id="reviewEditAgain" style="width:100%;margin-top:10px;background:#1a1a1a;color:#fff;border:1px solid rgba(255,255,255,0.3);padding:12px;border-radius:999px">← Back Ke Edit Scan</button>
  </div>
  </div>`;
  document.body.appendChild(m);
  let cur=dataUrl; let orig=dataUrl; let reviewOrig=dataUrl;
  let quad=[{x:8,y:8},{x:92,y:8},{x:92,y:82},{x:8,y:82}];
  let fitW=0, fitH=0; let zoom=1;
  const imgEl=m.querySelector('#cropImg'); const wrap=m.querySelector('#cropWrap'); const poly=m.querySelector('#quadPoly'); const handles=Array.from(m.querySelectorAll('[data-quad]'));
  function renderQuad(){
    handles.forEach((h,i)=>{ h.style.left=quad[i].x+'%'; h.style.top=quad[i].y+'%'; });
    const svg=m.querySelector('#quadSvg'); svg.setAttribute('viewBox','0 0 100 100'); svg.setAttribute('preserveAspectRatio','none');
    poly.setAttribute('points', quad.map(p=>p.x+','+p.y).join(' '));
    const dimSvg=m.querySelector('#dimSvg'); const dimPath=m.querySelector('#dimPath');
    if(dimSvg && dimPath){ dimSvg.setAttribute('viewBox','0 0 100 100'); dimSvg.setAttribute('preserveAspectRatio','none'); dimPath.setAttribute('d','M0,0 L100,0 L100,100 L0,100 Z M'+quad.map(p=>p.x+','+p.y).join(' ')+' Z'); }
  }
  function fitImage(){
    const vp=m.querySelector('#cropViewport'); const w=m.querySelector('#cropWrap'); const im=m.querySelector('#cropImg'); if(!vp||!w||!im) return;
    // Fit 92% - macam sebelum auto-detect
    const vw=vp.clientWidth*0.86; const vh=vp.clientHeight*0.82;
    const iw=im.naturalWidth||im.width||800; const ih=im.naturalHeight||im.height||1000; if(!iw||!ih) return;
    const sc=Math.min(vw/iw, vh/ih, 1); fitW=Math.round(iw*sc); fitH=Math.round(ih*sc);
    w.style.width=fitW+'px'; w.style.height=fitH+'px'; im.style.width=fitW+'px'; im.style.height=fitH+'px';
    const sp=m.querySelector('#zoomSpacer'); if(sp){ sp.style.width=fitW+'px'; sp.style.height=fitH+'px'; }
    renderQuad();
  }
  function showEdit(){ m.querySelector('#editStage').style.display='flex'; m.querySelector('#reviewStage').style.display='none'; m.querySelector('#cropTitle').textContent='Edit Scan'; const cu=m.querySelector('#cropUse'); if(cu) cu.style.display='block'; const hd=m.querySelector('#cropHeader'); if(hd) hd.style.display='flex'; }
  function showReview(url){ m.querySelector('#editStage').style.display='none'; const rs=m.querySelector('#reviewStage'); rs.style.display='flex'; m.querySelector('#reviewImg').src=url; const hd=m.querySelector('#cropHeader'); if(hd) hd.style.display='none'; }
  renderQuad();
  // Drag - bulat ikut jari tepat-tepat, tak ada offset, kanta tengah = bulat
  let draggingIdx=-1;
  function quadPointerDown(e, idx){ draggingIdx=idx; e.preventDefault(); e.stopPropagation(); const li=m.querySelector('#loupeImg'); if(li) li.src=imgEl.src; if(e.target.setPointerCapture){ try{ e.target.setPointerCapture(e.pointerId); }catch(err){} } }
  function quadPointerMove(e){
    if(draggingIdx<0) return; const r=wrap.getBoundingClientRect();
    let x=(e.clientX - r.left)/r.width*100; let y=(e.clientY - r.top)/r.height*100;
    x=Math.max(0,Math.min(100,x)); y=Math.max(0,Math.min(100,y)); quad[draggingIdx]={x,y}; renderQuad();
    const loupe=m.querySelector('#loupe'); const loupeImg=m.querySelector('#loupeImg');
    if(loupe && loupeImg){ const vp=m.querySelector('#cropViewport'); const vpr=vp.getBoundingClientRect(); loupe.style.display='block'; loupe.style.left=(e.clientX - vpr.left - 85)+'px'; loupe.style.top=(e.clientY - vpr.top - 85)+'px'; const zoomL=3; loupeImg.src=imgEl.src; loupeImg.style.width=(r.width*zoomL)+'px'; loupeImg.style.height=(r.height*zoomL)+'px'; const lx=x/100*r.width*zoomL; const ly=y/100*r.height*zoomL; loupeImg.style.transform='translate('+(85-lx)+'px,'+(85-ly)+'px)'; }
    e.preventDefault();
  }
  function quadPointerUp(){ draggingIdx=-1; const loupe=m.querySelector('#loupe'); if(loupe) loupe.style.display='none'; }
  handles.forEach((h,i)=>{ h.addEventListener('pointerdown', (e)=> quadPointerDown(e,i)); h.addEventListener('touchstart', (e)=>{ const tt=e.touches[0]; quadPointerDown({clientX:tt.clientX, clientY:tt.clientY, target:h, pointerId:999, preventDefault:()=>e.preventDefault(), stopPropagation:()=>{}}, i); }, {passive:false}); });
  window.addEventListener('pointermove', quadPointerMove, {passive:false}); window.addEventListener('pointerup', quadPointerUp); window.addEventListener('pointercancel', quadPointerUp);
  window.addEventListener('touchmove', (e)=>{ if(draggingIdx<0) return; const tt=e.touches[0]; quadPointerMove({clientX:tt.clientX, clientY:tt.clientY, preventDefault:()=>e.preventDefault()}); }, {passive:false}); window.addEventListener('touchend', quadPointerUp);
  const _fitImg=m.querySelector('#cropImg'); if(_fitImg){ _fitImg.onload=()=>{ fitImage(); }; if(_fitImg.complete) setTimeout(fitImage, 50); }
  window.addEventListener('resize', fitImage);
  // Next - warp ikut quad sekarang
  m.querySelector('#cropUse').onclick=()=>{ warpPerspective(cur, quad, (warped)=>{ reviewOrig=cur; cur=warped; showReview(warped); }); };
  m.querySelector('#cropCancel').onclick=()=>{ m.remove(); };
  m.querySelector('#reviewBack').onclick=()=>{ cur=reviewOrig; imgEl.src=cur; showEdit(); setTimeout(fitImage,50); };
  m.querySelector('#reviewEditAgain').onclick=()=>{ cur=reviewOrig; imgEl.src=cur; showEdit(); setTimeout(fitImage,50); };
  // Review Done - simpan terus ke thumb, apply scan contrast kalau Scan mode
  m.querySelector('#reviewDone').onclick=()=>{
    let out=cur;
    if(isScan){
      const tmp=new Image(); tmp.onload=()=>{ const cv=document.createElement('canvas'); cv.width=tmp.width; cv.height=tmp.height; const ctx=cv.getContext('2d'); ctx.drawImage(tmp,0,0); try{ const id=ctx.getImageData(0,0,cv.width,cv.height), d=id.data; for(let i=0;i<d.length;i+=4){ const g=d[i]*0.3+d[i+1]*0.59+d[i+2]*0.11; let v=(g-128)*1.3+128; v=Math.max(0,Math.min(255,v)); d[i]=d[i+1]=d[i+2]=v; } ctx.putImageData(id,0,0);}catch(e){} const finalOut=cv.toDataURL('image/jpeg',0.85); setThumb(finalOut); m.remove(); showToast('Scan siap'); }; tmp.src=out; return;
    }
    setThumb(out); m.remove(); showToast('Gambar dimasukkan');
  };
}


render();

</script><script>(function(){var loc=location.href.replace(/#.*$/,"");var ATTR_NAMES=["data-product-id","data-productid","data-product_id","product-id","productid","product_id","data-source-entity-id","source-entity-id","source_entity_id","data-product","data-metadata","data-meta"];var DATASET_KEYS=["productId","productid","product_id","sourceEntityId","sourceentityid","source_entity_id","product","metadata","meta"];function readProductId(value){if(typeof value!=="string"||value.length===0)return null;if(/^[0-9]{6,}$/.test(value))return value;var match=value.match(/(?:product(?:_|-)?id|source(?:_|-)?entity(?:_|-)?id)["'=:\s]+([0-9]{6,})/i);return match?match[1]:null}function extractProductId(start){for(var node=start;node&&node!==document.body;node=node.parentElement){for(var i=0;i<ATTR_NAMES.length;i++){var attrValue=node.getAttribute&&node.getAttribute(ATTR_NAMES[i]);var attrProductId=readProductId(attrValue);if(attrProductId)return attrProductId}var dataset=node.dataset||null;if(dataset){for(var j=0;j<DATASET_KEYS.length;j++){var dataValue=dataset[DATASET_KEYS[j]];var dataProductId=readProductId(dataValue);if(dataProductId)return dataProductId}}}return null}function isInlineMediaSlotElement(node){return !!(node&&node.getAttribute&&node.getAttribute("data-clippy-inline-media-slot")!==null)}function findInlineMediaSlot(start){for(var node=start;node&&node!==document.body;node=node.parentElement){if(isInlineMediaSlotElement(node))return node}return null}function readInlineMediaUrl(node){if(!node)return null;return node.getAttribute&&((node.getAttribute("data-clippy-inline-media-url")||node.getAttribute("data-url")||node.getAttribute("data_url")))||node.href||null}function stripHash(url){return String(url).replace(/#.*$/,"")}function urlsMatch(a,b){if(!a||!b)return false;try{return stripHash(new URL(a,loc).href)===stripHash(new URL(b,loc).href)}catch(_){return stripHash(a)===stripHash(b)}}function isFirstPartyReelUrl(value){try{var url=new URL(value,loc);if(url.protocol!=="https:")return false;var host=url.hostname.toLowerCase();var supported=host==="instagram.com"||host.endsWith(".instagram.com")||host==="facebook.com"||host.endsWith(".facebook.com");return supported&&/\/reels?\//i.test(url.pathname)}catch(_){return false}}function isInlineMediaUrlClick(node,href){var slot=findInlineMediaSlot(node);if(!slot)return false;var slotUrl=readInlineMediaUrl(slot);if(slotUrl)return urlsMatch(href,slotUrl);return isFirstPartyReelUrl(href)}function findDataHref(start){for(var node=start;node&&node!==document.body;node=node.parentElement){if(node.getAttribute){var href=node.getAttribute("data-href")||node.getAttribute("data-url");if(href)return{href:href,node:node}}}return null}var nativeOpen=window.open;window.open=function(url){if(parent!==window&&typeof url==="string"&&/^https?:\/\//.test(url)){parent.postMessage({type:"ecto:usercontent-link-click",href:url},"*");return null}return nativeOpen?nativeOpen.apply(window,arguments):null};document.addEventListener("click",function(e){var target=e.target instanceof Element?e.target:null;if(!target)return;if(parent===window)return;var a=target.closest?target.closest("a[href]"):null;if(a&&a.href&&/^https?:\/\//.test(a.href)&&a.href.replace(/#.*$/,"")!==loc){if(isInlineMediaUrlClick(a,a.href))return;var productId=extractProductId(target)||extractProductId(a);if(productId){e.preventDefault();parent.postMessage({type:"ecto-artifact-link-click",productId:productId},"*");return}e.preventDefault();parent.postMessage({type:"ecto:usercontent-link-click",href:a.href},"*");return}var dataHref=findDataHref(target);if(dataHref&&/^https?:\/\//.test(dataHref.href)&&dataHref.href.replace(/#.*$/,"")!==loc){if(isInlineMediaUrlClick(dataHref.node,dataHref.href))return;e.preventDefault();parent.postMessage({type:"ecto:usercontent-link-click",href:dataHref.href},"*")}},true)})();</script><script>(function(){var FOCUS_TYPE="ecto:artifact-focus-request";var CLOSE_TYPE="ecto:artifact-close-request";function focusArtifactDocument(){var body=document.body;if(!body)return;try{window.focus();}catch(e){}if(!body.hasAttribute("tabindex"))body.setAttribute("tabindex","-1");try{body.focus({preventScroll:true});}catch(e){try{body.focus();}catch(e2){}}}window.addEventListener("message",function(event){if(event.source!==window.parent)return;var data=event.data;if(!data||typeof data!=="object"||data.type!==FOCUS_TYPE)return;if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",focusArtifactDocument,{once:true});return;}focusArtifactDocument();});window.addEventListener("keydown",function(event){if(event.key!=="Escape")return;window.setTimeout(function(){if(event.defaultPrevented)return;window.parent.postMessage({type:CLOSE_TYPE},"*");},0);});})();</script></body></html>
