function renderCatManager(){ const box=document.getElementById('catListBox'); box.innerHTML=''; allCats().forEach(c=>{ const row=document.createElement('div'); row.style.cssText='display:flex;gap:8px;align-items:center;background:#f8fafc;border:1px solid #eee;border-radius:10px;padding:8px 10px'; row.innerHTML=`<span style="flex:1;font-weight:600">${c}</span>`; const eb=document.createElement('button'); eb.textContent='Edit'; eb.className='btn btn-light'; eb.style.cssText='padding:6px 10px;font-size:12px'; eb.onclick=()=>{ const baru=prompt('Edit kategori "'+c+'" jadi:',c); if(!baru||!baru.trim()||baru.trim()===c)return; const nc=baru.trim(); if(DEFAULT_CATS.includes(c)){ if(!hiddenCats.includes(c)) hiddenCats.push(c); } else { customCats=customCats.map(x=>x===c?nc:x); } if(!customCats.includes(nc)&&!DEFAULT_CATS.includes(nc)) customCats.push(nc); invoices.forEach(inv=>{if(inv.cat===c)inv.cat=nc}); save(); render(); renderCatManager(); showToast('Kategori ditukar'); }; const db=document.createElement('button'); db.textContent='Padam'; db.className='btn btn-light'; db.style.cssText='padding:6px 10px;font-size:12px;color:#dc2626'; db.onclick=()=>{ if(!confirm('Padam kategori "'+c+'"?'))return; if(DEFAULT_CATS.includes(c)){ if(!hiddenCats.includes(c)) hiddenCats.push(c); } else { customCats=customCats.filter(x=>x!==c); } invoices.forEach(inv=>{if(inv.cat===c)inv.cat='';}); save(); render(); renderCatManager(); }; row.appendChild(eb); row.appendChild(db); box.appendChild(row); }); }
