<html lang="ms"><style>* { -webkit-text-size-adjust: 109.00000000000001% !important; }</style><head><style>
@font-face {
  font-family: "Optimistic";
  font-style: normal;
  font-weight: 400 600;
  font-display: swap;
  src: url("/fonts/OptimisticAI_VF_Optimized.woff2") format("woff2");
}
@font-face {
  font-family: "Optimistic Mono";
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url("/fonts/OptimisticMono_W_TextRegular.woff2") format("woff2");
}
:where(html) {
  font-family: "Optimistic", system-ui, sans-serif;
}
:where(code, pre, kbd, samp) {
  font-family: "Optimistic Mono", ui-monospace, monospace;
}
</style><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Invoice Kedai</title><!-- VERSI BERIBU: IndexedDB, gambar auto-compress 800px JPEG 0.6, backup JSON tetap jalan -->
<style>
*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#eef2ee;color:#111;padding-bottom:110px}
.wrap{max-width:720px;margin:0 auto;padding:14px 14px 0}
header{display:flex;justify-content:space-between;align-items:flex-start}
h1{margin:4px 0 2px;font-size:28px}.sub{color:#666;font-size:13px}.badge{background:#fff;border:1px solid #ddd;border-radius:999px;padding:7px 12px;font-weight:700;font-size:13px}
.info{background:#d6f5dd;border-radius:14px;padding:12px 14px;font-weight:800;color:#14532d;margin:14px 0 10px}
.toolbar{display:flex;gap:8px;align-items:center}
.search{flex:1;display:flex;align-items:center;background:#fff;border:1px solid #ddd;border-radius:12px;padding:10px 12px;gap:8px}
.search input{border:0;outline:0;flex:1;font-size:14px}
.btn{border:0;border-radius:12px;padding:11px 14px;font-weight:700;cursor:pointer}
.btn-green{background:#16a34a;color:#fff}.btn-dark{background:#111827;color:#fff}.btn-light{background:#fff;border:1px solid #ddd}.btn-small{padding:8px 11px;font-size:12px;border-radius:999px}
.hint{font-size:12px;color:#666;margin:6px 2px}
.tabs{display:flex;background:#fff;border:1px solid #ddd;border-radius:999px;padding:4px;gap:4px;margin:8px 0}
.tab{flex:1;border:0;background:transparent;padding:10px;border-radius:999px;font-weight:700;cursor:pointer;color:#666}
.tab.active{background:#16a34a;color:#fff}
.group{background:#e8f5e9;border-radius:14px;padding:12px 14px;display:flex;justify-content:space-between;margin:14px 0 8px;cursor:pointer}
.group b{font-size:16px}.group small{color:#666}
.card{background:#fff;border-radius:16px;padding:12px;display:flex;gap:10px;margin:8px 0;align-items:flex-start;box-shadow:0 1px 3px rgba(0,0,0,.06)}
.thumb{width:64px;height:64px;border:1px solid #eee;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:11px;color:#666;overflow:hidden;background:#fafafa;flex-shrink:0}
.thumb img{width:100%;height:100%;object-fit:cover}
.meta{flex:1;min-width:0}.meta b{font-size:16px}.meta div{font-size:13px;color:#666}
.right{text-align:right;flex-shrink:0}.price{font-weight:800;font-size:16px}
.pill{display:inline-block;padding:4px 9px;border-radius:999px;font-size:12px;font-weight:700;margin-top:6px}
.paid{background:#dcfce7;color:#166534}.unpaid{background:#fef9c3;color:#854d0e}.pv{background:#dbeafe;color:#1e40af}.cash{background:#e0e7ff;color:#3730a3}
.bottom{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1px solid #ddd;padding:10px 12px calc(10px + env(safe-area-inset-bottom));display:flex;gap:8px;max-width:720px;margin:0 auto}
.bottom .btn{flex:1}.bottom .big{flex:2}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;align-items:flex-end;justify-content:center;z-index:20}
.modal.open{display:flex}.sheet{background:#fff;width:100%;max-width:720px;max-height:92vh;overflow:auto;border-radius:20px 20px 0 0;padding:16px 16px 24px}
input,select,textarea{width:100%;padding:11px 12px;border:1px solid #ddd;border-radius:12px;font-size:14px;margin:6px 0}
label{font-size:13px;font-weight:700}.row{display:flex;gap:8px}.row>*{flex:1}
.chk{display:flex;gap:8px;align-items:center;background:#f8fafc;border:1px solid #eee;border-radius:10px;padding:9px;margin:6px 0}
.bulkbar{display:none;background:#111827;color:#fff;border-radius:12px;padding:10px 12px;margin:8px 0;align-items:center;justify-content:space-between}
.bulkbar.show{display:flex}.empty{text-align:center;color:#666;padding:30px}
</style><script src="https://accounts.google.com/gsi/client" async="" defer=""></script></head>
<body><div class="wrap">
<header><div><h1>🧾 Invoice Kedai</h1><div class="sub" id="storageInfo" style="color:#16a34a;font-weight:600">Simpanan: 0 invoice • ~0 KB teks • IndexedDB</div><div class="sub" id="todaySub">Kedai • 11 Nov 2026 • Rekod tersimpan kekal</div></div><div class="badge">🟢 <span id="rekodCount">0</span> rekod</div></header>
<div class="info" id="infoBar">0 Invoice • RM 0.00</div>
<div class="toolbar">
<div class="search">🔍 <input id="q" placeholder="Cari supplier, no invoice, no PV"></div>
<button class="btn btn-green btn-small" id="filterBtn">Filter <span id="filterCount"></span></button>
</div>
<div class="toolbar" style="margin-top:8px">
<button class="btn btn-dark btn-small" id="reportBtn">📊 Report</button>
<button class="btn btn-small" id="settingBtn" style="background:#fff;border:1px solid #ddd">⚙️ Setting</button>
<span id="syncHint" style="display:none"></span>
</div>
<div class="hint" id="syncHintText" style="display: none; color: rgb(3, 105, 161);">Google Drive: Sedia • Tekan Sync untuk hantar • Offline auto-hold dalam phone</div><div class="hint" id="reportHint" style="display:none">Report ikut list semasa — 0 invoice dipaparkan.</div>
<div class="tabs">
<button class="tab active" data-tab="all">Invoice</button>
<button class="tab" data-tab="unpaid">Belum Bayar (<span id="unpaidN">0</span>)</button>
<button class="tab" data-tab="cancelled">PV Batal (<span id="cancelN">0</span>)</button>
</div>
<div class="bulkbar" id="bulkBar"><span id="bulkTxt">0 dipilih • RM 0.00</span><button class="btn btn-green" id="bulkPayBtn">Dah Bayar</button></div>
<div id="list"></div>
<div class="empty" id="empty" style="display: block;">Tiada invoice.</div>
</div>
<div class="bottom">
<button class="btn btn-green big" id="addBtn" style="flex:1">＋ Tambah Invoice</button>
<button id="exportBtn" style="display:none"></button><input type="file" id="fileInput" accept=".json" hidden="">
</div>

<!-- Add / Edit -->
<div class="modal" id="addModal"><div class="sheet">
<h2 id="addTitle">Tambah Invoice</h2>
<label>Nama / Supplier</label><input id="fName" placeholder="cth: abdul">
<label>No Invoice</label><input id="fInv" placeholder="cth: INV-001">
<label>Harga (RM)</label><input id="fPrice" type="number" step="0.01" placeholder="0.00">
<div class="row"><div><label>Tarikh Invoice</label><input id="fDate" type="date"></div><div><label>Jenis</label><select id="fJenis"><option>Stok</option><option>Pembekalan</option><option>Servis</option><option>Lain</option></select></div></div>
<label>Kategori</label><input id="fCat" placeholder="cth: Pembekalan">
<label>Nota</label><input id="fNote" placeholder="Nota (pilihan)">
<label>Gambar Resit (pilihan)</label><input id="fImg" type="file" accept="image/*">
<div class="row"><button class="btn btn-light" id="addCancel">Batal</button><button class="btn btn-green" id="addSave">Simpan</button></div>
</div></div>

<!-- Filter -->
<div class="modal" id="filterModal"><div class="sheet">
<h2>Filter</h2>
<label>Supplier</label><input id="fltSupplier" placeholder="Semua supplier">
<label>Status</label><select id="fltStatus"><option value="">Semua</option><option value="paid">Dah Bayar</option><option value="unpaid">Belum Bayar</option></select>
<label>Jenis Bayaran</label><select id="fltPay"><option value="">Semua</option><option>Cash</option><option>Bank Transfer</option><option>QR / E-Wallet</option><option>Split Payment</option></select>
<label>Jenis</label><select id="fltJenis"><option value="">Semua</option><option>Stok</option><option>Pembekalan</option><option>Servis</option><option>Lain</option></select>
<div class="row"><button class="btn btn-light" id="filterClear">Clear</button><button class="btn btn-green" id="filterApply">Terap</button></div>
</div></div>

<!-- Pay -->
<div class="modal" id="payModal"><div class="sheet">
<h2 id="payTitle">Bayar</h2>
<div id="paySummary" class="hint"></div>
<label>Tarikh Bayar</label><input id="payDate" type="date">
<label>Kaedah Bayaran</label>
<div class="row"><button class="btn btn-light payMethod active" data-m="Cash">Cash</button><button class="btn btn-light payMethod" data-m="Bank Transfer">Bank</button><button class="btn btn-light payMethod" data-m="QR / E-Wallet">QR / E-Wallet</button><button class="btn btn-light payMethod" data-m="Split Payment">Split</button></div>
<div id="splitBox" style="display:none;margin-top:10px"></div>
<div class="row" style="margin-top:12px"><button class="btn btn-light" id="payCancel">Batal</button><button class="btn btn-green" id="payConfirm">Sahkan Bayar</button></div>
</div></div>

<!-- Detail -->
<div class="modal" id="detailModal"><div class="sheet"><div id="detailBody"></div><div class="row" style="margin-top:12px"><button class="btn btn-light" id="detailClose">Tutup</button><button class="btn btn-green" id="detailPay" style="display:none">Dah Bayar</button><button class="btn btn-light" id="detailCancelPay" style="display:none">Batalkan Bayaran</button></div></div></div>

<div id="toast" style="position:fixed;left:50%;bottom:110px;transform:translateX(-50%);background:#111827;color:#fff;padding:12px 16px;border-radius:999px;font-size:13px;font-weight:700;display:none;z-index:99;box-shadow:0 4px 20px rgba(0,0,0,.3);max-width:90%;text-align:center"></div>

<div class="modal" id="driveModal"><div class="sheet">
<h2>⚙️ Setup Google Drive</h2>
<p style="font-size:13px;color:#666">Set sekali je. Lepas tu button Sync akan auto hantar ke Google Drive kau.</p>
<label>Google Client ID (OAuth Web)</label><input id="driveClientId" placeholder="123456...apps.googleusercontent.com">
<div style="background:#f0fdf4;border-radius:12px;padding:12px;font-size:13px;line-height:1.6">
<b>Cara dapat Client ID (2 minit):</b><br>
1. Buka <b>console.cloud.google.com</b> → New Project → nama <b>Invoice Kedai</b><br>
2. Menu → APIs &amp; Services → Library → cari <b>Google Drive API</b> → Enable<br>
3. APIs &amp; Services → Credentials → Create Credentials → <b>OAuth client ID</b> → Web application<br>
4. Authorized JavaScript origins tambah:<br>
• <b>https://USERNAME-kau.github.io</b><br>
• <b>http://localhost</b> (kalau test kat laptop)<br>
5. Copy Client ID → paste kat atas → Simpan<br>
6. Authorized redirect tak perlu isi untuk web ni.
</div>
<div class="row" style="margin-top:12px"><button class="btn btn-light" id="driveCancel">Tutup</button><button class="btn btn-green" id="driveSave">Simpan Client ID</button></div>
<p style="font-size:12px;color:#888">Client ID ni simpan dalam phone kau je, bukan dalam code GitHub. Selamat.</p>
</div></div>

<div class="modal" id="settingModal"><div class="sheet">
<h2>⚙️ Setting</h2><p style="font-size:13px;color:#666;margin:0">Dalam ni ada 4 button: Sync, Set Drive, Import, Export</p>
<p id="settingStatus" style="font-size:13px;color:#0369a1">Google Drive: Sedia • Offline auto-hold dalam phone</p>
<div style="display:flex;flex-direction:column;gap:12px;margin-top:12px">
<button class="btn btn-green" id="settingSyncBtn" style="padding:16px;text-align:left;font-size:15px">🔄 Sync Google Drive<br><span style="font-weight:400;font-size:12px;opacity:.9">Hantar backup ke Drive folder Invoice Kedai</span></button>
<button class="btn btn-light" id="settingSetDriveBtn" style="padding:16px;text-align:left;font-size:15px">⚙️ Set Drive<br><span style="font-weight:400;font-size:12px;color:#666">Masukkan Client ID Google — set sekali je</span></button>
<button class="btn btn-light" id="settingImportBtn" style="padding:16px;text-align:left;font-size:15px">⬆️ Import DB<br><span style="font-weight:400;font-size:12px;color:#666">Masuk backup JSON ke dalam phone ni</span></button>
<button class="btn btn-light" id="settingExportBtn" style="padding:16px;text-align:left;font-size:15px">⬇️ Export DB<br><span style="font-weight:400;font-size:12px;color:#666">Download backup JSON database</span></button>
</div>
<p style="font-size:12px;color:#888;margin-top:10px">Sync = hantar backup ke Google Drive folder Invoice Kedai.<br>Import/Export = backup / restore database dalam phone ni.</p>
<button class="btn btn-light" id="settingClose" style="margin-top:8px">Tutup</button>
</div></div>
<script>
let invoices = [];
let cancelledPVs = [];
// IndexedDB untuk beribu invoice - localStorage hanya 5MB, IndexedDB boleh 50MB-500MB ikut browser/phone
let db=null;
function openDB(){ return new Promise(res=>{ const req=indexedDB.open('invoice_kedai_db',1); req.onupgradeneeded=()=>{ const d=req.result; if(!d.objectStoreNames.contains('kv')) d.createObjectStore('kv'); }; req.onsuccess=()=>{db=req.result; res(db)}; req.onerror=()=>res(null); }); }
async function loadDB(){ try{ const d=await openDB(); if(!d) throw 0; const tx=d.transaction('kv','readonly'); const st=tx.objectStore('kv'); const get=k=>new Promise(r=>{const q=st.get(k); q.onsuccess=()=>r(q.result); q.onerror=()=>r(null)}); const a=await get('invoices'); const b=await get('cancelled'); if(a) invoices=a; if(b) cancelledPVs=b; }catch(e){ try{ invoices=JSON.parse(localStorage.getItem('invoice_kedai_v1')||'[]'); cancelledPVs=JSON.parse(localStorage.getItem('invoice_kedai_pv_batal_v1')||'[]'); }catch(_){}} render(); updateStorageInfo(); }
async function saveDB(){ try{ if(db){ const tx=db.transaction('kv','readwrite'); const st=tx.objectStore('kv'); st.put(invoices,'invoices'); st.put(cancelledPVs,'cancelled'); } }catch(e){} try{ localStorage.setItem('invoice_kedai_v1',JSON.stringify(invoices.slice(0,200))); }catch(e){} updateStorageInfo(); }
function updateStorageInfo(){ const approx=new Blob([JSON.stringify(invoices)]).size; const el=document.getElementById('storageInfo'); if(el) el.textContent=`Simpanan: ${invoices.length.toLocaleString()} invoice • ~${(approx/1024).toFixed(0)} KB teks • IndexedDB`; }
let tab='all', query='', filters={supplier:'',status:'',pay:'',jenis:''}, selected=new Set(), payMethod='Cash', payTargetIds=[], editId=null;
const $=s=>document.querySelector(s);
const fmt=n=> 'RM '+(Number(n)||0).toLocaleString('en-MY',{minimumFractionDigits:2,maximumFractionDigits:2});
const fmtShort=n=>{n=Number(n)||0;return Number.isInteger(n)? 'RM '+n.toLocaleString('en-MY') : fmt(n)};
const today=()=>new Date().toISOString().slice(0,10);
$('#fDate').value=today(); $('#payDate').value=today();
$('#todaySub').textContent='Kedai • '+new Date().toLocaleDateString('ms-MY',{day:'numeric',month:'short',year:'numeric'})+' • Rekod tersimpan kekal';
function save(){ saveDB(); }
function nextPV(){ const y=String(new Date().getFullYear()).slice(2), m=String(new Date().getMonth()+1).padStart(2,'0'); const prefix=`PV-${y}${m}-`; let max=0; [...invoices, ...cancelledPVs].forEach(x=>{if(x.pv&&x.pv.startsWith(prefix)){max=Math.max(max, parseInt(x.pv.split('-')[2])||0)}}); return prefix+String(max+1).padStart(3,'0'); }
function filtered(){
 let list=[...invoices];
 if(tab==='unpaid') list=list.filter(x=>!x.paid);
 if(tab==='cancelled') return []; // handled separately
 if(query){ const q=query.toLowerCase(); list=list.filter(x=>[x.name,x.inv,x.pv,x.cat,x.jenis].join(' ').toLowerCase().includes(q)); }
 if(filters.supplier) list=list.filter(x=>x.name.toLowerCase().includes(filters.supplier.toLowerCase()));
 if(filters.status) list=list.filter(x=>filters.status==='paid'?x.paid:!x.paid);
 if(filters.pay) list=list.filter(x=>x.payMethod===filters.pay);
 if(filters.jenis) list=list.filter(x=>x.jenis===filters.jenis);
 // sort: paid by payDate desc then invDate, unpaid at bottom by invDate
 list.sort((a,b)=>{ if(a.paid&&b.paid) return (b.payDate||'').localeCompare(a.payDate||'')||(b.date||'').localeCompare(a.date||''); if(a.paid&&!b.paid) return -1; if(!a.paid&&b.paid) return 1; return (b.date||'').localeCompare(a.date||''); });
 return list;
}
function render(){
 const list=filtered();
 const total=list.reduce((s,x)=>s+Number(x.price||0),0);
 const isFiltered = !!(query||filters.supplier||filters.status||filters.pay||filters.jenis||tab!=='all');
 $('#infoBar').textContent=`${list.length} Invoice • ${fmt(total)}`+(isFiltered?' • Filter aktif':'');
 $('#rekodCount').textContent=invoices.length;
 $('#unpaidN').textContent=invoices.filter(x=>!x.paid).length;
 $('#cancelN').textContent=cancelledPVs.length;
 $('#reportHint').textContent=`Report ikut list semasa — ${tab==='cancelled'?cancelledPVs.length:list.length} invoice dipaparkan.`;
 $('#filterCount').textContent = (filters.supplier||filters.status||filters.pay||filters.jenis)?' • 1':'';
 // bulk
 $('#bulkBar').classList.toggle('show', selected.size>0);
 $('#bulkTxt').textContent=`${selected.size} dipilih • ${fmt([...selected].reduce((s,id)=>{const it=invoices.find(y=>y.id===id);return s+ (it?Number(it.price||0):0)},0))}`;
 document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('active', t.dataset.tab===tab));
 const el=$('#list'); el.innerHTML='';
 if(tab==='cancelled'){
   if(!cancelledPVs.length){$('#empty').style.display='block';$('#empty').textContent='Tiada PV Batal.';return}
   $('#empty').style.display='none';
   cancelledPVs.slice().reverse().forEach(p=>{
     const d=document.createElement('div'); d.className='card'; d.innerHTML=`<div class="meta"><b>${p.pv} <span class="pill" style="background:#fee2e2;color:#991b1b">BATAL</span></b><div>${p.payDate||''} • ${p.name||''} • ${fmt(p.amount||0)}</div><div>${p.reason||'Bayaran dibatalkan'}</div></div>`;
     el.appendChild(d);
   }); return;
 }
 if(!list.length){$('#empty').style.display='block';$('#empty').textContent='Tiada invoice.';return}
 $('#empty').style.display='none';
 // group by payDate or invDate, then PV
 let groups={};
 list.forEach(x=>{ const key = x.paid? (x.payDate||x.date) : x.date; const gk = key+'|'+(x.paid? (x.pv||'') : 'BELUM'); if(!groups[gk]) groups[gk]=[]; groups[gk].push(x); });
 Object.entries(groups).forEach(([gk,items])=>{
   const [d,pv]=gk.split('|');
   const sum=items.reduce((s,x)=>s+Number(x.price||0),0);
   const g=document.createElement('div'); g.className='group';
   g.innerHTML=`<div><b>${new Date(d).toLocaleDateString('ms-MY',{day:'numeric',month:'short',year:'numeric'})}</b><div style="font-size:12px;color:#666">${items[0].paid?'Tarikh Bayar':'Tarikh Invoice'} • ${items.length} invoice ${pv&&pv!=='BELUM'?' • '+pv:''}</div></div><div style="text-align:right"><b>${fmt(sum)}</b><div style="font-size:12px;color:#666">Ketuk untuk tutup ▲</div></div>`;
   let collapsed=false; const wrap=document.createElement('div');
   items.forEach(x=>{
     const c=document.createElement('div'); c.className='card';
     const splitTxt = x.payMethod==='Split Payment' && x.split ? 'Split: '+Object.entries(x.split).filter(([k,v])=>v>0).map(([k,v])=>`${k.replace('Bank Transfer','Bank').replace('QR / E-Wallet','QR')} ${Number(v)}`).join(' • ') : '';
     c.innerHTML=`<input type="checkbox" ${selected.has(x.id)?'checked':''} style="width:26px;height:26px;margin-top:4px">
     <div class="thumb">${x.img?`<img src="${x.img}">`:'Resit'}</div>
     <div class="meta"><b>${x.name}</b><div>${x.date} • ${x.inv||'INV-'} • ${x.cat||x.jenis||''}</div>${splitTxt?`<div style="color:#111;font-weight:600">${splitTxt}</div>`:''}${x.payMethod&&x.payMethod!=='Split Payment'?`<span class="pill cash">${x.payMethod}</span>`:''}</div>
     <div class="right"><div class="price">${fmt(x.price)}</div><span class="pill ${x.paid?'paid':'unpaid'}">${x.paid?'Dah Bayar':'Belum Bayar'}</span>${x.paid&&x.pv?`<div><span class="pill pv">${x.pv}</span></div><div style="font-size:12px;color:#666;margin-top:4px">Bayar: ${x.payDate}</div>`:''}</div>`;
     c.querySelector('input').onchange=e=>{ if(e.target.checked) selected.add(x.id); else selected.delete(x.id); render(); };
     c.onclick=e=>{ if(e.target.tagName==='INPUT') return; openDetail(x.id); };
     wrap.appendChild(c);
   });
   g.onclick=()=>{collapsed=!collapsed; wrap.style.display=collapsed?'none':'block';};
   el.appendChild(g); el.appendChild(wrap);
 });
}
function openDetail(id){ const x=invoices.find(y=>y.id===id); if(!x) return; editId=id;
 $('#detailBody').innerHTML=`<h2>${x.name}</h2><p><b>${fmt(x.price)}</b> • ${x.date} • ${x.inv}</p><p>Kategori: ${x.cat||'-'} • Jenis: ${x.jenis||'-'}</p><p>Nota: ${x.note||'-'}</p>${x.img?`<img src="${x.img}" style="width:100%;border-radius:12px">`:''}${x.paid?`<p>Status: Dah Bayar • ${x.payMethod||''}<br>PV: ${x.pv||'-'} • Bayar: ${x.payDate||'-'}</p><p style="color:#666;font-size:13px">${x.split?'Split: '+JSON.stringify(x.split):''}</p>`:''}<div class="row"><button class="btn btn-light" id="delBtn">Padam Invoice</button><button class="btn btn-light" id="editBtn">Edit</button></div>`;
 $('#detailPay').style.display=x.paid?'none':'block';
 $('#detailCancelPay').style.display=x.paid?'block':'none';
 $('#detailModal').classList.add('open');
 $('#detailBody').querySelector('#delBtn').onclick=()=>{ if(confirm('Padam invoice ni?')){ invoices=invoices.filter(y=>y.id!==id); selected.delete(id); save(); render(); $('#detailModal').classList.remove('open'); } };
 $('#detailBody').querySelector('#editBtn').onclick=()=>{ $('#detailModal').classList.remove('open'); $('#fName').value=x.name; $('#fInv').value=x.inv; $('#fPrice').value=x.price; $('#fDate').value=x.date; $('#fJenis').value=x.jenis||'Stok'; $('#fCat').value=x.cat||''; $('#fNote').value=x.note||''; $('#addTitle').textContent='Edit Invoice'; $('#addModal').classList.add('open'); };
}
document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>{tab=t.dataset.tab; selected.clear(); render();});
$('#q').oninput=e=>{query=e.target.value; render();};
$('#filterBtn').onclick=()=>{ $('#fltSupplier').value=filters.supplier; $('#fltStatus').value=filters.status; $('#fltPay').value=filters.pay; $('#fltJenis').value=filters.jenis; $('#filterModal').classList.add('open'); };
$('#filterApply').onclick=()=>{ filters={supplier:$('#fltSupplier').value,status:$('#fltStatus').value,pay:$('#fltPay').value,jenis:$('#fltJenis').value}; $('#filterModal').classList.remove('open'); render(); };
$('#filterClear').onclick=()=>{ filters={supplier:'',status:'',pay:'',jenis:''}; $('#filterModal').classList.remove('open'); render(); };
$('#addBtn').onclick=()=>{ editId=null; $('#addTitle').textContent='Tambah Invoice'; $('#fName').value=''; $('#fInv').value=''; $('#fPrice').value=''; $('#fDate').value=today(); $('#fNote').value=''; $('#addModal').classList.add('open'); };
$('#addCancel').onclick=()=>$('#addModal').classList.remove('open');
$('#addSave').onclick=()=>{
 const name=$('#fName').value.trim()||'Tanpa Nama', price=parseFloat($('#fPrice').value)||0;
 if(!price){alert('Isi harga');return}
 const file=$('#fImg').files[0];
 const done=(img)=>{ if(editId){ const x=invoices.find(y=>y.id===editId); Object.assign(x,{name,inv:$('#fInv').value,price,date:$('#fDate').value||today(),jenis:$('#fJenis').value,cat:$('#fCat').value,note:$('#fNote').value, img: img||x.img}); } else { invoices.unshift({id:Date.now().toString(),name,inv:$('#fInv').value,price,date:$('#fDate').value||today(),jenis:$('#fJenis').value,cat:$('#fCat').value,note:$('#fNote').value,img:img||'',paid:false}); } $('#fImg').value=''; save(); render(); $('#addModal').classList.remove('open'); };
 if(file){ const r=new FileReader(); r.onload=()=>{ const img=new Image(); img.onload=()=>{ const c=document.createElement('canvas'); const maxW=800; const scale=Math.min(1,maxW/img.width); c.width=img.width*scale; c.height=img.height*scale; c.getContext('2d').drawImage(img,0,0,c.width,c.height); done(c.toDataURL('image/jpeg',0.6)); }; img.src=r.result; }; r.readAsDataURL(file); } else done('');
};
$('#detailClose').onclick=()=>$('#detailModal').classList.remove('open');
$('#detailPay').onclick=()=>{ $('#detailModal').classList.remove('open'); openPay([editId]); };
$('#detailCancelPay').onclick=()=>{ const x=invoices.find(y=>y.id===editId); if(!x||!x.paid) return; if(!confirm(`Batalkan bayaran ${x.pv} ? PV lama akan ditanda BATAL.`)) return; cancelledPVs.push({pv:x.pv, payDate:x.payDate, name:x.name, amount:x.price, reason:'Bayaran dibatalkan', at:Date.now()}); x.paid=false; x.pv=''; x.payDate=''; x.payMethod=''; x.split=null; save(); render(); $('#detailModal').classList.remove('open'); };
function openPay(ids){ payTargetIds=ids; payMethod='Cash'; document.querySelectorAll('.payMethod').forEach(b=>b.classList.toggle('active', b.dataset.m==='Cash')); $('#splitBox').style.display='none'; const total=ids.reduce((s,id)=>{const it=invoices.find(y=>y.id===id);return s+(it?Number(it.price||0):0)},0); $('#payTitle').textContent=`Bayar (${ids.length} invoice)`; $('#paySummary').textContent=`Total: ${fmt(total)} • PV baru akan dijana: ${nextPV()} (1 PV untuk semua invoice ni)`; $('#payDate').value=today(); $('#payModal').classList.add('open'); buildSplit(total); }
function buildSplit(total){ const box=$('#splitBox'); box.innerHTML=''; ['Cash','Bank Transfer','QR / E-Wallet'].forEach(m=>{ const d=document.createElement('div'); d.className='chk'; d.innerHTML=`<input type="checkbox" data-m="${m}"> <b>${m}</b> <input type="number" data-amt="${m}" placeholder="RM 0" style="margin:0">`; box.appendChild(d); }); box.querySelectorAll('input[type=checkbox]').forEach(cb=>cb.onchange=()=>{ const amt=box.querySelector(`input[data-amt="${cb.dataset.m}"]`); if(cb.checked && !amt.value) amt.value=''; }); }
document.querySelectorAll('.payMethod').forEach(b=>b.onclick=()=>{ payMethod=b.dataset.m; document.querySelectorAll('.payMethod').forEach(x=>x.classList.toggle('active', x===b)); $('#splitBox').style.display= payMethod==='Split Payment'?'block':'none'; });
$('#payCancel').onclick=()=>$('#payModal').classList.remove('open');
$('#bulkPayBtn').onclick=()=>{ const ids=[...selected].filter(id=>{const it=invoices.find(y=>y.id===id);return it&&!it.paid}); if(!ids.length){alert('Pilih invoice Belum Bayar dulu');return} openPay(ids); };
$('#payConfirm').onclick=()=>{
 const payDate=$('#payDate').value||today(); const pv=nextPV(); let split=null;
 if(payMethod==='Split Payment'){ split={}; let sum=0; document.querySelectorAll('#splitBox input[type=checkbox]').forEach(cb=>{ if(cb.checked){ const v=parseFloat(document.querySelector(`input[data-amt="${cb.dataset.m}"]`).value)||0; if(v>0){split[cb.dataset.m]=v; sum+=v;} } }); const total=payTargetIds.reduce((s,id)=>{const it=invoices.find(y=>y.id===id);return s+(it?Number(it.price||0):0)},0); if(!Object.keys(split).length){alert('Tick sekurang-kurangnya 1 kaedah dan isi amaun');return} if(Math.abs(sum-total)>0.01){ if(!confirm(`Jumlah split ${fmt(sum)} tak sama dengan total ${fmt(total)}. Teruskan?`)) return; } }
 payTargetIds.forEach(id=>{ const x=invoices.find(y=>y.id===id); if(x){ x.paid=true; x.payDate=payDate; x.pv=pv; x.payMethod=payMethod; x.split=split; } });
 selected.clear(); save(); render(); $('#payModal').classList.remove('open'); alert(`Dah Bayar • PV ${pv}`);
};
$('#exportBtn').onclick=()=>{ const blob=new Blob([JSON.stringify({invoices,cancelledPVs,exportedAt:new Date().toISOString()},null,2)],{type:'application/json'}); const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=`invoice-kedai-backup-${today()}.json`; a.click(); };
if($('#importBtn')) $('#importBtn').onclick=()=>$('#fileInput').click();
$('#fileInput').onchange=e=>{ const f=e.target.files[0]; if(!f) return; const r=new FileReader(); r.onload=()=>{ try{ const d=JSON.parse(r.result); const mode=confirm('OK = Ganti Semua, Cancel = Tambah Saja'); if(mode){ invoices=d.invoices||[]; cancelledPVs=d.cancelledPVs||[]; } else { invoices=[...(d.invoices||[]),...invoices]; cancelledPVs=[...(d.cancelledPVs||[]),...cancelledPVs]; } save(); render(); alert('Import berjaya'); }catch(err){ alert('Fail JSON tak sah'); } }; r.readAsText(f); e.target.value=''; };
$('#reportBtn').onclick=()=>{
 const list = tab==='cancelled'? cancelledPVs.map(p=>({name:p.name,inv:'',price:p.amount,date:p.payDate,jenis:'',cat:'',payMethod:'PV Batal',paid:true,pv:p.pv,payDate:p.payDate,note:'BATAL'})) : filtered();
 let csv='\uFEFFTarikh Invoice,No Invoice,Supplier,Kategori,Jenis,Payment Type,Split,Status,Tarikh Bayar,No PV,Harga,Nota\n';
 list.forEach(x=>{ const split = x.split? Object.entries(x.split).filter(([k,v])=>v>0).map(([k,v])=>`${k} ${v}`).join(' • '):''; const row=[x.date||'',x.inv||'',x.name||'',x.cat||'',x.jenis||'',x.payMethod||'',split,x.paid?'Dah Bayar':'Belum Bayar',x.payDate||'',x.pv||'',x.price||0,(x.note||'').replace(/,/g,' ')]; csv+=row.map(v=>`"${String(v).replace(/"/g,'""')}"`).join(',')+'\n'; });
 const blob=new Blob([csv],{type:'text/csv'}); const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=`invoice-kedai-report-${today()}.csv`; a.click();
};
document.querySelectorAll('.modal').forEach(m=>m.addEventListener('click',e=>{ if(e.target===m) m.classList.remove('open'); }));


// ===== SYNC GOOGLE DRIVE (auto) =====
let driveClientId = localStorage.getItem('invoice_kedai_drive_client_id')||'';
let driveToken = null;
let pendingSync = JSON.parse(localStorage.getItem('invoice_kedai_pending_sync')||'[]');
document.getElementById('settingBtn').onclick=()=>{ document.getElementById('settingModal').classList.add('open'); const st=document.getElementById('settingStatus'); if(st) st.textContent = !navigator.onLine ? `⏸️ Offline — ${pendingSync.length} sync di-hold` : (pendingSync.length>0 ? `☁️ ${pendingSync.length} sync tertunggak` : 'Google Drive: Sedia • Offline auto-hold dalam phone'); };
document.getElementById('settingClose').onclick=()=>document.getElementById('settingModal').classList.remove('open');
 document.getElementById('settingSetDriveBtn').onclick=()=>{ document.getElementById('settingModal').classList.remove('open'); document.getElementById('driveClientId').value=driveClientId; document.getElementById('driveModal').classList.add('open'); };
 document.getElementById('settingSyncBtn').onclick=()=>{ document.getElementById('settingModal').classList.remove('open'); uploadToDrive(); };
 document.getElementById('settingImportBtn').onclick=()=>{ document.getElementById('settingModal').classList.remove('open'); document.getElementById('fileInput').click(); };
 document.getElementById('settingExportBtn').onclick=()=>{ document.getElementById('settingModal').classList.remove('open'); const blob=new Blob([JSON.stringify({invoices,cancelledPVs,exportedAt:new Date().toISOString()},null,2)],{type:'application/json'}); const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=`invoice-kedai-backup-${today()}.json`; a.click(); showToast('✅ Export DB siap'); };
 document.getElementById('driveCancel').onclick=()=>document.getElementById('driveModal').classList.remove('open');
document.getElementById('driveSave').onclick=()=>{ driveClientId=document.getElementById('driveClientId').value.trim(); if(!driveClientId){alert('Paste Client ID dulu');return} localStorage.setItem('invoice_kedai_drive_client_id', driveClientId); document.getElementById('driveModal').classList.remove('open'); showToast('✅ Drive Client ID disimpan. Boleh tekan Sync sekarang.'); };

function getDriveToken(){
  return new Promise((resolve,reject)=>{
    if(!driveClientId){ document.getElementById('driveModal').classList.add('open'); reject(new Error('no-client')); return; }
    const client = google.accounts.oauth2.initTokenClient({
      client_id: driveClientId,
      scope: 'https://www.googleapis.com/auth/drive.file',
      callback: (resp)=>{ if(resp.access_token){ driveToken=resp.access_token; resolve(resp.access_token); } else reject(new Error('no-token')); }
    });
    client.requestAccessToken({prompt: driveToken?'':'consent'});
  });
}
async function uploadToDrive(){
  const total = invoices.length;
  if(total===0){ showToast('Tiada receipt untuk sync'); return; }
  if(!navigator.onLine){
    const snap={at:Date.now(), date:new Date().toISOString(), count:total, invoices, cancelledPVs};
    pendingSync.push(snap); localStorage.setItem('invoice_kedai_pending_sync', JSON.stringify(pendingSync)); updateSyncHint();
    showToast(`⏸️ Offline — ${total} receipt di-hold dulu dalam phone. Akan sync bila online.`);
    return;
  }
  try{
    const token = driveToken || await getDriveToken();
    showToast(`☁️ Syncing ${total} receipt ke Google Drive...`);
    // 1. Cari / buat folder Invoice Kedai
    let folderId = localStorage.getItem('invoice_kedai_drive_folder')||'';
    if(!folderId){
      const q = encodeURIComponent("name='Invoice Kedai' and mimeType='application/vnd.google-apps.folder' and trashed=false");
      const r = await fetch(`https://www.googleapis.com/drive/v3/files?q=${q}`, {headers:{Authorization:'Bearer '+token}});
      const j = await r.json();
      if(j.files && j.files.length>0){ folderId=j.files[0].id; }
      else{
        const cr = await fetch('https://www.googleapis.com/drive/v3/files', {method:'POST', headers:{Authorization:'Bearer '+token,'Content-Type':'application/json'}, body:JSON.stringify({name:'Invoice Kedai', mimeType:'application/vnd.google-apps.folder'})});
        const cj = await cr.json(); folderId=cj.id;
      }
      localStorage.setItem('invoice_kedai_drive_folder', folderId);
    }
    // 2. Upload JSON backup
    const data = JSON.stringify({invoices, cancelledPVs, syncedAt:new Date().toISOString(), count:total}, null, 2);
    const fileName = `invoice-kedai-${today()}.json`;
    const meta = {name: fileName, parents:[folderId], mimeType:'application/json'};
    const form = new FormData();
    form.append('metadata', new Blob([JSON.stringify(meta)],{type:'application/json'}));
    form.append('file', new Blob([data],{type:'application/json'}));
    const up = await fetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart', {method:'POST', headers:{Authorization:'Bearer '+token}, body:form});
    const uj = await up.json();
    if(uj.error) throw new Error(uj.error.message||'Drive upload gagal');
    pendingSync=[]; localStorage.removeItem('invoice_kedai_pending_sync'); updateSyncHint();
    showToast(`✅ ${total} receipt synchronized ke Google Drive`);
    // Simpan juga last sync info
    localStorage.setItem('invoice_kedai_last_sync', JSON.stringify({at:Date.now(), count:total, fileId:uj.id}));
  }catch(e){
    if(e.message==='no-client') return;
    console.error(e);
    showToast('⚠️ Drive sync gagal — cuba tekan Sync lagi / check Client ID');
  }
}
// Override old sync button to use Drive
// sync via Setting modal now
// Auto retry pending bila online balik
window.addEventListener('online', ()=>{
  if(pendingSync.length>0){
    const last=pendingSync[pendingSync.length-1];
    showToast(`📶 Online balik — ${last.count} receipt tertunggak. Tekan Sync Google Drive untuk hantar.`, 5000);
  }
});

// ===== SYNC iCLOUD (lama - fallback)  (cara iPhone / web) =====
// Jujur: Web di GitHub Pages TAK BOLEH terus tulis ke iCloud macam app native,
// sebab Apple tak buka API iCloud Drive untuk website luar.
// Cara yang Apple benarkan: guna Share Sheet iPhone -> Save to Files -> iCloud Drive.
// Button ni buat benda tu + offline queue.
/* pendingSync moved up */
function showToast(msg, ms=3500){ const t=document.getElementById('toast'); t.textContent=msg; t.style.display='block'; clearTimeout(t._h); t._h=setTimeout(()=>t.style.display='none', ms); }
function updateSyncHint(){
  const h=document.getElementById('syncHintText'); if(!h) return;
  if(!navigator.onLine){ h.textContent=`⏸️ Offline — ${pendingSync.length} sync di-hold. Akan auto sync bila online.`; h.style.color='#b45309'; }
  else if(pendingSync.length>0){ h.textContent=`Google Drive Online — ${pendingSync.length} sync tertunggak, tekan Sync iCloud.`; h.style.color='#b45309'; }
  else { h.textContent=`Google Drive: Sedia • Tekan Sync untuk hantar • Offline auto-hold dalam phone`; h.style.color='#0369a1'; }
}
async function doSync(){
  const total = invoices.length;
  if(total===0){ showToast('Tiada receipt untuk sync'); return; }
  if(!navigator.onLine){
    // HOLD dulu - simpan dalam phone
    const snap = { at: Date.now(), date: new Date().toISOString(), count: total, invoices: invoices, cancelledPVs: cancelledPVs };
    pendingSync.push(snap);
    localStorage.setItem('invoice_kedai_pending_sync', JSON.stringify(pendingSync));
    updateSyncHint();
    showToast(`⏸️ Offline — ${total} receipt di-hold dulu dalam phone. Akan sync bila online.`);
    return;
  }
  // ONLINE - cuba Share ke iCloud Drive via Files
  const data = JSON.stringify({invoices, cancelledPVs, syncedAt: new Date().toISOString(), count: total}, null, 2);
  const file = new File([data], `invoice-kedai-${today()}.json`, {type:'application/json'});
  const isIPhone = /iPhone|iPad|iPod/.test(navigator.userAgent);
  try{
    if(navigator.share && navigator.canShare && navigator.canShare({files:[file]})){
      await navigator.share({ title:'Invoice Kedai Backup', text:`${total} receipt - Invoice Kedai`, files:[file] });
      // Lepas share, user pilih Save to Files > iCloud Drive
      showToast(`✅ ${total} receipt synchronized — pilih Save to Files > iCloud Drive tadi`);
      pendingSync=[]; localStorage.removeItem('invoice_kedai_pending_sync'); updateSyncHint();
      return;
    }
    throw new Error('share-not-supported');
  }catch(e){
    // Fallback: download - user pilih Save to Files > iCloud Drive manual
    if(e && e.name==='AbortError'){ showToast('Sync dibatalkan'); return; }
    const a=document.createElement('a'); a.href=URL.createObjectURL(new Blob([data],{type:'application/json'})); a.download=`invoice-kedai-${today()}.json`; a.click();
    if(isIPhone){
      showToast(`✅ ${total} receipt sedia — tekan Share > Save to Files > iCloud Drive`);
    } else {
      showToast(`✅ ${total} receipt synchronized (fail dimuat turun - simpan dalam iCloud Drive)`);
    }
    pendingSync=[]; localStorage.removeItem('invoice_kedai_pending_sync'); updateSyncHint();
  }
}
// syncBtn removed - sync via Setting modal
window.addEventListener('online', ()=>{
  updateSyncHint();
  if(pendingSync.length>0){
    const last = pendingSync[pendingSync.length-1];
    showToast(`📶 Online balik — ${last.count} receipt tertunggak sedia untuk sync. Tekan ☁️ Sync iCloud.`, 5000);
  } else {
    showToast('📶 Online balik');
  }
});
window.addEventListener('offline', ()=>{ updateSyncHint(); showToast('⏸️ Offline — data simpan dalam phone dulu'); });
updateSyncHint();

loadDB();
</script><script>(function(){var loc=location.href.replace(/#.*$/,"");var ATTR_NAMES=["data-product-id","data-productid","data-product_id","product-id","productid","product_id","data-source-entity-id","source-entity-id","source_entity_id","data-product","data-metadata","data-meta"];var DATASET_KEYS=["productId","productid","product_id","sourceEntityId","sourceentityid","source_entity_id","product","metadata","meta"];function readProductId(value){if(typeof value!=="string"||value.length===0)return null;if(/^[0-9]{6,}$/.test(value))return value;var match=value.match(/(?:product(?:_|-)?id|source(?:_|-)?entity(?:_|-)?id)["'=:\s]+([0-9]{6,})/i);return match?match[1]:null}function extractProductId(start){for(var node=start;node&&node!==document.body;node=node.parentElement){for(var i=0;i<ATTR_NAMES.length;i++){var attrValue=node.getAttribute&&node.getAttribute(ATTR_NAMES[i]);var attrProductId=readProductId(attrValue);if(attrProductId)return attrProductId}var dataset=node.dataset||null;if(dataset){for(var j=0;j<DATASET_KEYS.length;j++){var dataValue=dataset[DATASET_KEYS[j]];var dataProductId=readProductId(dataValue);if(dataProductId)return dataProductId}}}return null}function isInlineMediaSlotElement(node){return !!(node&&node.getAttribute&&node.getAttribute("data-clippy-inline-media-slot")!==null)}function findInlineMediaSlot(start){for(var node=start;node&&node!==document.body;node=node.parentElement){if(isInlineMediaSlotElement(node))return node}return null}function readInlineMediaUrl(node){if(!node)return null;return node.getAttribute&&((node.getAttribute("data-clippy-inline-media-url")||node.getAttribute("data-url")||node.getAttribute("data_url")))||node.href||null}function stripHash(url){return String(url).replace(/#.*$/,"")}function urlsMatch(a,b){if(!a||!b)return false;try{return stripHash(new URL(a,loc).href)===stripHash(new URL(b,loc).href)}catch(_){return stripHash(a)===stripHash(b)}}function isFirstPartyReelUrl(value){try{var url=new URL(value,loc);if(url.protocol!=="https:")return false;var host=url.hostname.toLowerCase();var supported=host==="instagram.com"||host.endsWith(".instagram.com")||host==="facebook.com"||host.endsWith(".facebook.com");return supported&&/\/reels?\//i.test(url.pathname)}catch(_){return false}}function isInlineMediaUrlClick(node,href){var slot=findInlineMediaSlot(node);if(!slot)return false;var slotUrl=readInlineMediaUrl(slot);if(slotUrl)return urlsMatch(href,slotUrl);return isFirstPartyReelUrl(href)}function findDataHref(start){for(var node=start;node&&node!==document.body;node=node.parentElement){if(node.getAttribute){var href=node.getAttribute("data-href")||node.getAttribute("data-url");if(href)return{href:href,node:node}}}return null}var nativeOpen=window.open;window.open=function(url){if(parent!==window&&typeof url==="string"&&/^https?:\/\//.test(url)){parent.postMessage({type:"ecto:usercontent-link-click",href:url},"*");return null}return nativeOpen?nativeOpen.apply(window,arguments):null};document.addEventListener("click",function(e){var target=e.target instanceof Element?e.target:null;if(!target)return;if(parent===window)return;var a=target.closest?target.closest("a[href]"):null;if(a&&a.href&&/^https?:\/\//.test(a.href)&&a.href.replace(/#.*$/,"")!==loc){if(isInlineMediaUrlClick(a,a.href))return;var productId=extractProductId(target)||extractProductId(a);if(productId){e.preventDefault();parent.postMessage({type:"ecto-artifact-link-click",productId:productId},"*");return}e.preventDefault();parent.postMessage({type:"ecto:usercontent-link-click",href:a.href},"*");return}var dataHref=findDataHref(target);if(dataHref&&/^https?:\/\//.test(dataHref.href)&&dataHref.href.replace(/#.*$/,"")!==loc){if(isInlineMediaUrlClick(dataHref.node,dataHref.href))return;e.preventDefault();parent.postMessage({type:"ecto:usercontent-link-click",href:dataHref.href},"*")}},true)})();</script><script>(function(){var FOCUS_TYPE="ecto:artifact-focus-request";var CLOSE_TYPE="ecto:artifact-close-request";function focusArtifactDocument(){var body=document.body;if(!body)return;try{window.focus();}catch(e){}if(!body.hasAttribute("tabindex"))body.setAttribute("tabindex","-1");try{body.focus({preventScroll:true});}catch(e){try{body.focus();}catch(e2){}}}window.addEventListener("message",function(event){if(event.source!==window.parent)return;var data=event.data;if(!data||typeof data!=="object"||data.type!==FOCUS_TYPE)return;if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",focusArtifactDocument,{once:true});return;}focusArtifactDocument();});window.addEventListener("keydown",function(event){if(event.key!=="Escape")return;window.setTimeout(function(){if(event.defaultPrevented)return;window.parent.postMessage({type:CLOSE_TYPE},"*");},0);});})();</script>
</body></html>
